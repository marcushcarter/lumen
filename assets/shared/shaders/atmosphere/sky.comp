#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

#include "common/camera.glsl"
#include "common/gbuffer.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_storage_rgba16f[];
layout(set = 0, binding = 2) uniform sampler u_samplers[];

#include "common/atmosphere.glsl"
#include "common/sky.glsl"

layout(push_constant, scalar) uniform Push {
    CameraBuffer camera;
    AtmosphereBuffer atmosphere;
    uint depth_index;
    uint material_index;
    uint out_slot;
    uint width;
    uint height;
    uint transmittance_index;
    uint skyview_index;
    uint sampler_index;
    float sun_reject_cos;
    float moon_reject_cos;
} pc;

const float HDR_MAX = 60000.0;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;

    float depth = texelFetch(u_textures[pc.depth_index], p, 0).r;
    if (depth != 0.0) {
        float roughness, metallic, ao;
        uint shading_model;
        gbuffer_decode_material(texelFetch(u_textures[pc.material_index], p, 0), roughness, metallic, ao, shading_model);
        if (shading_model != SHADING_MODEL_SKY) return;
    }

    g_atmo = pc.atmosphere;
    g_lut_sampler = pc.sampler_index;
    g_transmittance_lut = pc.transmittance_index;

    vec2 ndc = (vec2(p) + 0.5) / vec2(pc.width, pc.height) * 2.0 - 1.0;
    vec4 near_h = pc.camera.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec3 view_dir = normalize(near_h.xyz / near_h.w - pc.camera.position.xyz);

    float pixel_angle = 2.0 * pc.camera.tan_half_fov_y / float(pc.height);
    vec3 color = sky_color(view_dir, pc.skyview_index, pixel_angle, pc.camera.pre_exposure, pc.sun_reject_cos, pc.moon_reject_cos) * pc.camera.pre_exposure;
    imageStore(u_storage_rgba16f[pc.out_slot], p, vec4(min(color, vec3(HDR_MAX)), 1.0));
}