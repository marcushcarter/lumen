#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_storage_rgba16f[];
layout(set = 0, binding = 2) uniform sampler u_samplers[];

#include "common/atmosphere.glsl"

layout(push_constant, scalar) uniform Push {
    AtmosphereBuffer atmosphere;
    uint transmittance_index;
    uint multiscatter_index;
    uint sampler_index;
    uint out_slot;
    uint width;
    uint height;
} pc;

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (id.x >= int(pc.width) || id.y >= int(pc.height)) return;
    g_atmo = pc.atmosphere;
    g_lut_sampler = pc.sampler_index;
    g_transmittance_lut = pc.transmittance_index;
    g_multiscatter_lut = pc.multiscatter_index;

    vec2 uv = (vec2(id) + 0.5) / vec2(pc.width, pc.height);
    vec3 ro = atmo_observer();
    vec3 rd = skyview_dir(uv, length(ro));
    bool sun_active = atmo_sun_active();
    ScatterResult s = integrate_scattering(ro, rd, 1e9, 32.0, true, sun_active, atmo_moon_active());
    
    vec3 radiance = s.sun * g_atmo.sun_illuminance + s.moon * g_atmo.moon_illuminance;
    if (!s.hit_ground) radiance += atmo_airglow(length(ro), rd.y);
    float e_ref = sun_active ? g_atmo.sun_illuminance.g : g_atmo.moon_illuminance.g;
    vec3 stored = min(radiance * (ATMO_LUT_SCALE / max(e_ref, 1e-12)), vec3(ATMO_LUT_MAX));
    imageStore(u_storage_rgba16f[pc.out_slot], id, vec4(stored, sun_active ? 1.0 : 0.0));
}