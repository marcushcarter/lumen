#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_nonuniform_qualifier : require

#include "common/geometry.glsl"
#include "common/camera.glsl"
#include "common/instances.glsl"

layout(local_size_x = 64) in;

// layout(set = 0, binding = 0) uniform texture2D u_textures[];
// layout(set = 0, binding = 1) uniform image2D u_storage_images[];
// layout(set = 0, binding = 2) uniform sampler u_samplers[];

layout(buffer_reference, scalar) readonly buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };
layout(buffer_reference, scalar) buffer VisibleClusterBuffer { uint count; uint data[]; };
layout(buffer_reference, scalar) buffer ClusterRetestBuffer { uint count; uint data[]; };

layout(push_constant) uniform Push {
    CameraBuffer camera;
    GeometryBuffer geometry;
    InstanceBuffer instances;
    TransformBuffer transforms;
    ClusterRefsBuffer cluster_refs;
    VisibleClusterBuffer visible_clusters;
    ClusterRetestBuffer cluster_retest;
    uint hiz_index;
    float px_per_unit;
} pc;

bool cull_frustum(vec3 center_ws, float radius_ws) {
    for (int i = 0; i < 6; i++) {
        vec4 pl = pc.camera.frustum_planes[i];
        if (dot(pl.xyz, center_ws) + pl.w < -radius_ws) return true;
    }
    return false;
}

float sphere_error_px(vec4 s, float err, mat4 model, float scale, vec3 cam, float ppu) {
    vec3 c = (model * vec4(s.xyz, 1.0)).xyz;
    float d = max(length(c - cam) - s.w * scale, 1e-4);
    return err * scale * ppu / d;
}

float group_error_px(uint gi, mat4 model, float scale, vec3 cam, float ppu) {
    ClusterGroup g = pc.geometry.groups.data[gi];
    return sphere_error_px(g.sphere, g.error, model, scale, cam, ppu);
}

bool lod_reject(Cluster cluster, mat4 model, float scale, vec3 cam, float ppu) {
    const float T = 1.0;
    float self_px = (cluster.self_group == 0xffffffffu) ? 0.0 : group_error_px(cluster.self_group, model, scale, cam, ppu);
    float parent_px = (cluster.parent_group == 0xffffffffu) ? 3.402823e38 : group_error_px(cluster.parent_group, model, scale, cam, ppu);
    return !(self_px <= T && parent_px > T);
}

bool cull_occlusion(vec3 center_ws, float radius_ws) {
    return false;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= pc.cluster_refs.count) return;

    uvec2 ref = pc.cluster_refs.data[id];
    uint instance_id = ref.x;
    uint cluster_id = ref.y;

    Instance instance = pc.instances.data[instance_id];
    mat4 model = pc.transforms.data[instance.transform_id].curr_mtx;
    Cluster cluster = pc.geometry.clusters.data[cluster_id];

    float scale = max(length(model[0].xyz), max(length(model[1].xyz), length(model[2].xyz)));

    if (lod_reject(cluster, model, scale, pc.camera.position.xyz, pc.px_per_unit)) return;

    vec3 center = (model * vec4(cluster.cull_sphere.xyz, 1.0)).xyz;
    float radius = cluster.cull_sphere.w * scale;
    if (cull_frustum(center, radius)) return;

    if (cull_occlusion(center, radius)) {
        uint slot = atomicAdd(pc.cluster_retest.count, 1u);
        pc.cluster_retest.data[slot] = id;
        return;
    }

    uint slot = atomicAdd(pc.visible_clusters.count, 1u);
    pc.visible_clusters.data[slot] = id;
}