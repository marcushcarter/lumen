#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require

#include "common/geometry.glsl"
#include "common/camera.glsl"
#include "common/instances.glsl"

layout(local_size_x = 64) in;

layout(buffer_reference, scalar) readonly buffer VisibleInstanceBuffer { uint count; uint data[]; };
layout(buffer_reference, scalar) readonly buffer OffsetBuffer { uint data[]; };
layout(buffer_reference, scalar) buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };

layout(push_constant) uniform Push {
    CameraBuffer camera;
    GeometryBuffer geometry;
    InstanceBuffer instances;
    TransformBuffer transforms;
    VisibleInstanceBuffer visible_instances;
    OffsetBuffer offsets;
    ClusterRefsBuffer cluster_refs;
    float px_per_unit;
} pc;

bool cull_frustum(vec3 center_ws, float radius_ws) {
    for (int i = 0; i < 6; i++) {
        vec4 pl = pc.camera.frustum_planes[i];
        if (dot(pl.xyz, center_ws) + pl.w < -radius_ws) return true;
    }
    return false;
}

float sphere_error_px(vec4 s, float err, mat4 model, float scale, vec3 cam, float ppu) {
    vec3 c = (model * vec4(s.xyz, 1.0)).xyz;
    float d = max(length(c - cam) - s.w * scale, 1e-4);
    return err * scale * ppu / d;
}

float group_error_px(uint gi, mat4 model, float scale, vec3 cam, float ppu) {
    ClusterGroup g = pc.geometry.groups.data[gi];
    return sphere_error_px(g.sphere, g.error, model, scale, cam, ppu);
}

bool lod_reject(Cluster cluster, mat4 model, float scale, vec3 cam, float ppu) {
    const float T = 1.0;
    float self_px = (cluster.self_group == 0xffffffffu) ? 0.0 : group_error_px(cluster.self_group, model, scale, cam, ppu);
    float parent_px = (cluster.parent_group == 0xffffffffu) ? 3.402823e38 : group_error_px(cluster.parent_group, model, scale, cam, ppu);
    return !(self_px <= T && parent_px > T);
}

bool _keep(Cluster cluster, mat4 model, float scale, vec3 cam, float ppu) {
    if (lod_reject(cluster, model, scale, cam, ppu)) return false;
    vec3 center = (model * vec4(cluster.cull_sphere.xyz, 1.0)).xyz;
    float radius = cluster.cull_sphere.w * scale;
    if (cull_frustum(center, radius)) return false;
    return true;
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    uint n = pc.visible_instances.count;
    uint total = pc.offsets.data[n];

    bool keep = false;
    uint instance_id = 0u;
    uint cluster_id = 0u;

    if (t < total) {
        uint lo = 0u, hi = n;
        while (lo + 1u < hi) {
            uint mid = (lo + hi) >> 1u;
            if (pc.offsets.data[mid] <= t) lo = mid; else hi = mid;
        }
        uint c = t - pc.offsets.data[lo];

        instance_id = pc.visible_instances.data[lo];
        Instance instance = pc.instances.data[instance_id];
        Mesh mesh = pc.geometry.meshes.data[instance.mesh_id];
        mat4 model = pc.transforms.data[instance.transform_id].curr_mtx;
        float scale = max(length(model[0].xyz), max(length(model[1].xyz), length(model[2].xyz)));

        cluster_id = mesh.cluster_base + c;
        Cluster cl = pc.geometry.clusters.data[cluster_id];
        keep = _keep(cl, model, scale, pc.camera.position.xyz, pc.px_per_unit);
    }

    uvec4 ballot = subgroupBallot(keep);
    uint cnt = subgroupBallotBitCount(ballot);
    uint my = subgroupBallotExclusiveBitCount(ballot);
    uint base = 0u;
    if (cnt > 0u) {
        if (subgroupElect()) base = atomicAdd(pc.cluster_refs.count, cnt);
        base = subgroupBroadcastFirst(base);
    }
    if (keep) pc.cluster_refs.data[base + my] = uvec2(instance_id, cluster_id);
}