#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require

#include "common/geometry.glsl"
#include "common/camera.glsl"
#include "common/instances.glsl"
#include "common/lod.glsl"

layout(local_size_x = 64) in;

layout(buffer_reference, scalar) readonly buffer VisibleInstanceBuffer { uint count; uint data[]; };
layout(buffer_reference, scalar) readonly buffer OffsetBuffer { uint data[]; };
layout(buffer_reference, scalar) buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };
layout(buffer_reference, scalar) buffer ClusterRetestBuffer { uint count; uint data[]; };

layout(push_constant) uniform Push {
    CameraBuffer camera;
    GeometryBuffer geometry;
    InstanceBuffer instances;
    TransformBuffer transforms;
    VisibleInstanceBuffer visible_instances;
    OffsetBuffer offsets;
    ClusterRefsBuffer cluster_refs;
    ClusterRetestBuffer cluster_retest;
    float px_per_unit;
    uint late;
    uint ref_capacity;
} pc;

bool _keep(Cluster cluster, mat4 model, float scale, vec3 cam, float ppu) {
    if (!lod_selected(pc.geometry, cluster, model, scale, cam, ppu)) return false;
    vec3 center = (model * vec4(cluster.cull_sphere.xyz, 1.0)).xyz;
    float radius = cluster.cull_sphere.w * scale;
    if (frustum_cull_sphere(pc.camera, center, radius)) return false;
    return true;
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    uint n = pc.visible_instances.count;
    uint total = pc.offsets.data[n];

    bool keep = false;
    uint instance_id = 0u;
    uint cluster_id = 0u;

    if (t < total) {
        uint lo = 0u, hi = n;
        while (lo + 1u < hi) {
            uint mid = (lo + hi) >> 1u;
            if (pc.offsets.data[mid] <= t) lo = mid; else hi = mid;
        }
        uint c = t - pc.offsets.data[lo];

        instance_id = pc.visible_instances.data[lo];
        Instance instance = pc.instances.data[instance_id];
        Mesh mesh = pc.geometry.meshes.data[instance.mesh_id];
        mat4 model = pc.transforms.data[instance.transform_id].curr_mtx;
        float scale = transform_max_scale(model);

        cluster_id = mesh.cluster_base + c;
        Cluster cl = pc.geometry.clusters.data[cluster_id];
        keep = _keep(cl, model, scale, pc.camera.position.xyz, pc.px_per_unit);
    }

    uvec4 ballot = subgroupBallot(keep);
    uint cnt = subgroupBallotBitCount(ballot);
    uint my = subgroupBallotExclusiveBitCount(ballot);
    uint base = 0u;
    if (cnt > 0u) {
        if (subgroupElect()) base = atomicAdd(pc.cluster_refs.count, cnt);
        base = subgroupBroadcastFirst(base);
    }

    bool written = keep && base + my < pc.ref_capacity;
    if (written) pc.cluster_refs.data[base + my] = uvec2(instance_id, cluster_id);

    if (pc.late != 0u) {
        uvec4 wb = subgroupBallot(written);
        uint wn = subgroupBallotBitCount(wb);
        uint rbase = 0u;
        if (wn > 0u) {
            if (subgroupElect()) rbase = atomicAdd(pc.cluster_retest.count, wn);
            rbase = subgroupBroadcastFirst(rbase);
        }
        if (written) pc.cluster_retest.data[rbase + subgroupBallotExclusiveBitCount(wb)] = base + my;
    }
}