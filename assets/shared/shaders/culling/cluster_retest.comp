#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require

#include "common/geometry.glsl"
#include "common/camera.glsl"
#include "common/instances.glsl"
#include "common/hiz.glsl"
#include "culling/cone_cull.glsl"

layout(local_size_x = 64) in;

layout(buffer_reference, scalar) readonly buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };
layout(buffer_reference, scalar) readonly buffer ClusterRetestBuffer { uint count; uint data[]; };
layout(buffer_reference, scalar) buffer ClusterListBuffer { uint count; uint data[]; };

layout(push_constant) uniform Push {
    CameraBuffer camera;
    GeometryBuffer geometry;
    InstanceBuffer instances;
    TransformBuffer transforms;
    ClusterRefsBuffer cluster_refs;
    ClusterRetestBuffer cluster_retest;
    ClusterListBuffer visible_clusters;
    ClusterListBuffer skin_clusters;
    uint hiz_index;
    uint hiz_mips;
    uint hiz_enabled;
    uint skin_enabled;
    vec2 screen_size;
} pc;

void main() {
    uint id = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 64u + gl_LocalInvocationID.x;
    bool valid = id < pc.cluster_retest.count;

    uint ref_idx = 0u;
    bool occluded = false;
    bool backfacing = false;
    bool skinned = false;
    if (valid) {
        ref_idx = pc.cluster_retest.data[id];
        uvec2 ref = pc.cluster_refs.data[ref_idx];
        Instance instance = pc.instances.data[ref.x];
        mat4 model = pc.transforms.data[instance.transform_id].curr_mtx;
        skinned = instance.skin_id != SKIN_NONE;
        backfacing = cluster_backfacing(pc.camera, pc.geometry, instance, model, ref.y);
        if (!backfacing && !skinned && pc.hiz_enabled != 0u) {
            vec3 box_min, box_extent;
            cluster_box(pc.geometry, pc.geometry.meshes.data[instance.mesh_id], ref.y, box_min, box_extent);
            occluded = hiz_occluded_box(pc.hiz_index, pc.hiz_mips, pc.screen_size, pc.camera.curr_view_proj, model, box_min, box_extent);
        }
    }

    bool keep = valid && !backfacing && !occluded;
    bool to_skin = keep && skinned && pc.skin_enabled != 0u;
    uvec4 kb = subgroupBallot(keep);
    uvec4 sb = subgroupBallot(to_skin);
    uint kn = subgroupBallotBitCount(kb);
    uint sn = subgroupBallotBitCount(sb);
    uint base = 0u;
    uint sbase = 0u;
    if (subgroupElect()) {
        if (kn > 0u) base = atomicAdd(pc.visible_clusters.count, kn);
        if (sn > 0u) sbase = atomicAdd(pc.skin_clusters.count, sn);
    }
    base = subgroupBroadcastFirst(base);
    sbase = subgroupBroadcastFirst(sbase);
    if (keep) pc.visible_clusters.data[base + subgroupBallotExclusiveBitCount(kb)] = ref_idx;
    if (to_skin) pc.skin_clusters.data[sbase + subgroupBallotExclusiveBitCount(sb)] = ref_idx;
}