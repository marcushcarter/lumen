#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require

#include "common/geometry.glsl"
#include "common/camera.glsl"
#include "common/instances.glsl"
#include "common/hiz.glsl"

layout(local_size_x = 64) in;

layout(buffer_reference, scalar) readonly buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };
layout(buffer_reference, scalar) readonly buffer ClusterRetestBuffer { uint count; uint data[]; };
layout(buffer_reference, scalar) buffer ClusterListBuffer { uint count; uint data[]; };

layout(push_constant) uniform Push {
    CameraBuffer camera;
    GeometryBuffer geometry;
    InstanceBuffer instances;
    TransformBuffer transforms;
    ClusterRefsBuffer cluster_refs;
    ClusterRetestBuffer cluster_retest;
    ClusterListBuffer visible_clusters;
    uint hiz_index;
    uint hiz_mips;
    uint hiz_enabled;
    uint _pad;
    vec2 screen_size;
} pc;

void main() {
    uint id = gl_GlobalInvocationID.x;
    bool valid = id < pc.cluster_retest.count;

    uint ref_idx = 0u;
    bool occluded = false;
    if (valid) {
        ref_idx = pc.cluster_retest.data[id];
        if (pc.hiz_enabled != 0u) {
            uvec2 ref = pc.cluster_refs.data[ref_idx];
            Instance instance = pc.instances.data[ref.x];
            mat4 model = pc.transforms.data[instance.transform_id].curr_mtx;
            Cluster cluster = pc.geometry.clusters.data[ref.y];

            float scale = transform_max_scale(model);
            vec3 center = (model * vec4(cluster.cull_sphere.xyz, 1.0)).xyz;
            occluded = hiz_occluded(pc.hiz_index, pc.hiz_mips, pc.screen_size, pc.camera.curr_view_proj, center, cluster.cull_sphere.w * scale);
        }
    }

    bool keep = valid && !occluded;
    uvec4 kb = subgroupBallot(keep);
    uint kn = subgroupBallotBitCount(kb);
    uint base = 0u;
    if (subgroupElect() && kn > 0u) base = atomicAdd(pc.visible_clusters.count, kn);
    base = subgroupBroadcastFirst(base);
    if (keep) pc.visible_clusters.data[base + subgroupBallotExclusiveBitCount(kb)] = ref_idx;
}