#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 1) in;

layout(buffer_reference, scalar) readonly buffer ClusterRetestBuffer { uint count; uint data[]; };
layout(buffer_reference, scalar) writeonly buffer IndirectDispatch { uint x; uint y; uint z; };

layout(push_constant) uniform Push {
    ClusterRetestBuffer cluster_retest;
    IndirectDispatch retest_args;
} pc;

void main() {
    uint groups = (pc.cluster_retest.count + 63u) / 64u;
    pc.retest_args.x = min(groups, 65535u);
    pc.retest_args.y = (groups + 65534u) / 65535u;
    pc.retest_args.z = 1u;
}