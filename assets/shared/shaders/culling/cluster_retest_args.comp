#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 256) in;

layout(buffer_reference, scalar) readonly buffer ClusterRetestBuffer { uint count; uint data[]; };
layout(buffer_reference, scalar) writeonly buffer IndirectDispatch { uint x; uint y; uint z; };
layout(buffer_reference, scalar) writeonly buffer CountBuffer { uint data[]; };
layout(buffer_reference, scalar) writeonly buffer HiZArgsBuffer { uvec3 build; };

layout(push_constant) uniform Push {
    ClusterRetestBuffer cluster_retest;
    IndirectDispatch retest_args;
    CountBuffer counts;
    HiZArgsBuffer hiz_args;
    uint cluster_count;
    uint init_hiz_args;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid < pc.cluster_count) pc.counts.data[gid] = 0u;
    if (gid != 0u) return;

    uint groups = (pc.cluster_retest.count + 63u) / 64u;
    pc.retest_args.x = min(groups, 65535u);
    pc.retest_args.y = (groups + 65534u) / 65535u;
    pc.retest_args.z = 1u;

    if (pc.init_hiz_args != 0u) pc.hiz_args.build = uvec3(0u, 1u, 1u);
}