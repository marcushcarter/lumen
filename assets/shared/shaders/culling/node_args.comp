#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 1) in;

layout(buffer_reference, scalar) buffer NodeQueueBuffer { uint count; };
layout(buffer_reference, scalar) writeonly buffer IndirectDispatch { uint x; uint y; uint z; };

layout(push_constant) uniform Push {
    NodeQueueBuffer filled;
    NodeQueueBuffer next;
    IndirectDispatch traverse_args;
    uint capacity;
} pc;

void main() {
    uint count = min(pc.filled.count, pc.capacity);
    pc.filled.count = count;
    uint groups = (count + 63u) / 64u;
    pc.traverse_args.x = min(groups, 65535u);
    pc.traverse_args.y = (groups + 65534u) / 65535u;
    pc.traverse_args.z = 1u;
    pc.next.count = 0u;
}
