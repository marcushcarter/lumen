#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

#include "common/geometry.glsl"
#include "common/shadow_cull.glsl"

layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform Push {
    GeometryBuffer geometry;
    ShadowClusterList clusters;
    ShadowDrawArgs args;
    ShadowIndexBuffer indices;
    uint cascade;
    uint cluster_capacity;
    uint tri_capacity;
} pc;

void main() {
    const uint slot = shadow_group_index();
    if (slot >= min(pc.args.data[pc.cascade * SHADOW_ARGS_STRIDE + SHADOW_ARGS_CLUSTERS], pc.cluster_capacity)) return;
    const uvec4 ref = pc.clusters.data[pc.cascade * pc.cluster_capacity + slot];
    const uint first = pc.geometry.clusters.data[ref.y].index_base / 3u;
    const uint count = pc.geometry.clusters.data[ref.y].index_count / 3u;
    const uint vbase = slot << SHADOW_LOCAL_BITS;
    const uint region = pc.cascade * pc.tri_capacity * 3u;

    for (uint t = gl_LocalInvocationID.x; t < count; t += 64u) {
        const uint out_tri = ref.z + t;
        if (out_tri >= pc.tri_capacity) break;
        const uint lt = pc.geometry.local_triangles.data[first + t];
        const uint w = region + out_tri * 3u;
        pc.indices.data[w + 0u] = vbase | (lt & 0xFFu);
        pc.indices.data[w + 1u] = vbase | ((lt >> 8u) & 0xFFu);
        pc.indices.data[w + 2u] = vbase | ((lt >> 16u) & 0xFFu);
    }
}
