#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#include "common/geometry.glsl"
#include "common/camera.glsl"
#include "common/instances.glsl"
#include "common/direct_light.glsl"
#include "common/shadow_cull.glsl"

layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform Push {
    CameraBuffer camera;
    GeometryBuffer geometry;
    InstanceBuffer instances;
    TransformBuffer transforms;
    DirectLightBuffer direct_light;
    ShadowWorkList lists;
    uint instance_count;
    uint list_stride;
    uint list_capacity;
    uint cascade_mask;
} pc;

void main() {
    const uint id = gl_GlobalInvocationID.x;
    const uint cascade = gl_WorkGroupID.y;
    if (((pc.cascade_mask >> cascade) & 1u) == 0u) return;

    uint chunks = 0u;
    if (id < pc.instance_count) {
        Instance instance = pc.instances.data[id];
        mat4 model = pc.transforms.data[instance.transform_id].curr_mtx;
        Mesh mesh = pc.geometry.meshes.data[instance.mesh_id];
        vec4 sphere = mesh.bounds_sphere;
        if (instance.skin_id != SKIN_NONE) {
            SkinInstance skin = pc.camera.skins.data[instance.skin_id];
            sphere = vec4(skin.box_min + skin.box_extent * 0.5, length(skin.box_extent) * 0.5);
        }
        vec3 center = (model * vec4(sphere.xyz, 1.0)).xyz;
        float radius = sphere.w * transform_max_scale(model);
        if (!shadow_cull_sphere(pc.direct_light.cascade_view_proj[cascade], center, radius)) chunks = (mesh.cluster_count + SHADOW_CHUNK - 1u) / SHADOW_CHUNK;
    }

    const uint base = cascade * pc.list_stride;
    const uint offset = subgroupExclusiveAdd(chunks);
    const uint total = subgroupAdd(chunks);
    uint first = 0u;
    if (total > 0u && subgroupElect()) first = atomicAdd(pc.lists.data[base + SHADOW_LIST_COUNT], total);
    first = subgroupBroadcastFirst(first) + offset;
    for (uint k = 0u; k < chunks; k++) {
        const uint item = first + k;
        if (item >= pc.list_capacity) break;
        pc.lists.data[base + SHADOW_LIST_HEADER + item * 2u] = id;
        pc.lists.data[base + SHADOW_LIST_HEADER + item * 2u + 1u] = k * SHADOW_CHUNK;
    }
}
