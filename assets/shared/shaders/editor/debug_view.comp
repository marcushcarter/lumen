#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

#include "common/geometry.glsl"
#include "common/camera.glsl"
#include "common/instances.glsl"
#include "common/gbuffer.glsl"
#include "common/lod.glsl"
#include "common/visbuffer.glsl"
#include "common/skinning.glsl"
#include "editor/debug_palette.glsl"
#include "editor/debug_op.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform utexture2D u_textures_uint[];
layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1, rgba16f) uniform image2D u_storage_rgba16f[];

layout(buffer_reference, scalar) readonly buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };

layout(push_constant) uniform Push {
    CameraBuffer camera;
    ClusterRefsBuffer cluster_refs;
    InstanceBuffer instances;
    GeometryBuffer geometry;
    TransformBuffer transforms;
    uint vis_index;
    uint depth_index;
    uint src_index;
    uint out_slot;
    uint op;
    uint width;
    uint height;
    float px_per_unit;
} pc;

float linearize_depth(ivec2 coord) {
    float depth = texelFetch(u_textures[nonuniformEXT(pc.src_index)], coord, 0).r;
    depth = 1.0 - depth;
    const float N = 1.0;
    depth /= pc.camera.far_z - depth * (pc.camera.far_z - N);
    return depth;
}

float view_depth_at(ivec2 coord) {
    float raw = texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r;
    return pc.camera.near_z * pc.camera.far_z / (pc.camera.near_z + raw * (pc.camera.far_z - pc.camera.near_z));
}

vec3 view_pos_at(ivec2 coord, ivec2 size) {
    vec2 ndc = (vec2(coord) + 0.5) / vec2(size) * 2.0 - 1.0;
    float aspect = float(size.x) / float(size.y);
    float z = view_depth_at(coord);
    float t = pc.camera.tan_half_fov_y;
    return vec3(ndc.x * t * aspect * z, ndc.y * t * z, z);
}

vec3 view_normal_from_depth(ivec2 coord, ivec2 size) {
    vec2 ps  = 1.0 / vec2(size);
    ivec2 cN = clamp(coord + ivec2(0, -1), ivec2(0), size - 1);
    ivec2 cE = clamp(coord + ivec2(1,  0), ivec2(0), size - 1);
    vec3 vC = vec3((vec2(coord) + 0.5) * ps - 0.5, 1.0) * linearize_depth(coord);
    vec3 vN = vec3((vec2(cN) + 0.5) * ps - 0.5, 1.0) * linearize_depth(cN);
    vec3 vE = vec3((vec2(cE) + 0.5) * ps - 0.5, 1.0) * linearize_depth(cE);
    return normalize(cross(vC - vN, vC - vE));
}

vec3 clay_normal(ivec2 coord, ivec2 size) {
    ivec2 hi = size - 1;
    vec3 c = view_pos_at(coord, size);
    vec3 l = view_pos_at(clamp(coord + ivec2(-1, 0), ivec2(0), hi), size);
    vec3 r = view_pos_at(clamp(coord + ivec2( 1, 0), ivec2(0), hi), size);
    vec3 u = view_pos_at(clamp(coord + ivec2(0, -1), ivec2(0), hi), size);
    vec3 d = view_pos_at(clamp(coord + ivec2(0,  1), ivec2(0), hi), size);
    bool use_r = coord.x == 0 || (coord.x < hi.x && abs(r.z - c.z) < abs(c.z - l.z));
    bool use_d = coord.y == 0 || (coord.y < hi.y && abs(d.z - c.z) < abs(c.z - u.z));
    vec3 dx = use_r ? r - c : c - l;
    vec3 dy = use_d ? d - c : c - u;
    return normalize(cross(dy, dx));
}

float wrapped_diffuse(float n_dot_l, float wrap) {
    return max((n_dot_l + wrap) / ((1.0 + wrap) * (1.0 + wrap)), 0.0);
}

vec3 clay_shade(vec3 n, vec3 p) {
    const vec3 L_DIR[3] = vec3[3](normalize(vec3(-0.5, -0.7, -0.6)), normalize(vec3(0.8, -0.2, -0.4)), normalize(vec3(0.0, 0.8, -0.3)));
    const vec3 L_COL[3] = vec3[3](vec3(0.8), vec3(0.35), vec3(0.15));
    const float L_WRAP[3] = float[3](0.3, 0.5, 0.8);
    vec3 v = normalize(-p);
    vec3 diffuse = vec3(0.1);
    float spec = 0.0;
    for (int i = 0; i < 3; ++i) {
        diffuse += L_COL[i] * wrapped_diffuse(dot(n, L_DIR[i]), L_WRAP[i]);
        vec3 h = normalize(L_DIR[i] + v);
        spec += pow(max(dot(n, h), 0.0), 40.0) * L_COL[i].r * 0.15;
    }
    return vec3(0.8) * diffuse + vec3(spec);
}

bool sample_vis(ivec2 coord, out uvec2 v, out uvec2 ref) {
    float d = texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r;
    if (d == 0.0) return false;
    const uint raw = texelFetch(u_textures_uint[nonuniformEXT(pc.vis_index)], coord, 0).x;
    if (vis_is_empty(raw) || vis_is_terrain(raw)) return false;
    ref = pc.cluster_refs.data[vis_cluster_ref(raw)];
    v = uvec2(raw, vis_triangle(raw));
    return true;
}

const float WIRE_HALF_WIDTH = 0.5;
const float WIRE_BASE_DIM = 0.35;
const vec3 WIRE_COLOR = vec3(0.9);

const float TRI_DENSITY_LOG2_MIN = -2.0;
const float TRI_DENSITY_LOG2_MAX = 6.0;

uvec3 triangle_cluster_vertices(uint cluster, uint tri) {
    const uint lt = pc.geometry.local_triangles.data[pc.geometry.clusters.data[cluster].index_base / 3u + tri];
    const uint vbase = pc.geometry.cluster_vertex_base.data[cluster];
    return uvec3(vbase + (lt & 0xFFu), vbase + ((lt >> 8u) & 0xFFu), vbase + ((lt >> 16u) & 0xFFu));
}

vec3 vertex_local(Instance inst, Mesh mesh, uint cluster, uint cluster_vertex) {
    vec3 p = mesh.pos_min + vertex_position_unorm(pc.geometry.cluster_vertices.data[cluster_vertex].xy) * mesh.pos_extent;
    if (inst.skin_id != SKIN_NONE) p = skin_point(skin_blend(pc.camera, pc.camera.skins.data[inst.skin_id].joint_base, skin_vertex(pc.geometry, cluster, cluster_vertex), SKIN_CURR), p);
    return p;
}

vec3 project_vertex_px(uint cluster, uint cluster_vertex, Instance inst, Mesh mesh, mat4 mvp, vec2 size) {
    vec4 clip = mvp * vec4(vertex_local(inst, mesh, cluster, cluster_vertex), 1.0);
    return vec3((clip.xy * 0.5 + 0.5 * clip.w) * size, clip.w);
}

float wire_edge_distance(vec3 a, vec3 b, vec2 p) {
    vec3 l = cross(a, b);
    return abs(dot(l, vec3(p, 1.0))) / max(length(l.xy), 1e-20);
}

float wire_distance(ivec2 coord, ivec2 size, uvec2 v, uvec2 ref) {
    Instance inst = pc.instances.data[ref.x];
    Mesh mesh = pc.geometry.meshes.data[inst.mesh_id];
    mat4 mvp = pc.camera.curr_view_proj * pc.transforms.data[inst.transform_id].curr_mtx;
    uvec3 cv = triangle_cluster_vertices(ref.y, v.y);
    vec2 fsize = vec2(size);
    vec3 a = project_vertex_px(ref.y, cv.x, inst, mesh, mvp, fsize);
    vec3 b = project_vertex_px(ref.y, cv.y, inst, mesh, mvp, fsize);
    vec3 c = project_vertex_px(ref.y, cv.z, inst, mesh, mvp, fsize);
    vec2 p = vec2(coord) + 0.5;
    return min(wire_edge_distance(a, b, p), min(wire_edge_distance(b, c, p), wire_edge_distance(c, a, p)));
}

float triangle_pixel_area(ivec2 size, uvec2 v, uvec2 ref) {
    Instance inst = pc.instances.data[ref.x];
    Mesh mesh = pc.geometry.meshes.data[inst.mesh_id];
    mat4 mvp = pc.camera.curr_view_proj * pc.transforms.data[inst.transform_id].curr_mtx;
    uvec3 cv = triangle_cluster_vertices(ref.y, v.y);
    vec2 fsize = vec2(size);
    vec3 a = project_vertex_px(ref.y, cv.x, inst, mesh, mvp, fsize);
    vec3 b = project_vertex_px(ref.y, cv.y, inst, mesh, mvp, fsize);
    vec3 c = project_vertex_px(ref.y, cv.z, inst, mesh, mvp, fsize);
    if (a.z <= 0.0 || b.z <= 0.0 || c.z <= 0.0) return 3.402823e38;
    vec2 p0 = a.xy / a.z;
    vec2 p1 = b.xy / b.z;
    vec2 p2 = c.xy / c.z;
    return 0.5 * abs((p1.x - p0.x) * (p2.y - p0.y) - (p2.x - p0.x) * (p1.y - p0.y));
}

const uint LOD_HEAT_MAX_LEVEL = 9u;

const float UV_CHECKER_TILES = 8.0;

const vec3 STREAM_FULL_COLOR = vec3(0.15, 0.75, 0.25);
const vec3 STREAM_WAITING_COLOR = vec3(1.0, 0.8, 0.05);
const vec3 STREAM_STARVED_COLOR = vec3(1.0, 0.1, 0.05);
const vec3 STREAM_RESIDENT_COLOR = vec3(0.35);

vec3 streaming_color(uvec2 ref) {
    const Instance inst = pc.instances.data[ref.x];
    const Mesh mesh = pc.geometry.meshes.data[inst.mesh_id];
    if (mesh.page_count == 0u || pc.geometry.page_resident.data[mesh.page_base + mesh.page_count - 1u] == PAGE_PERMANENT) return STREAM_RESIDENT_COLOR;
    const Cluster c = pc.geometry.clusters.data[ref.y];
    if (c.self_group == CLUSTER_GROUP_NONE || lod_group_refined(pc.geometry, c.self_group)) return STREAM_FULL_COLOR;
    const mat4 model = pc.transforms.data[inst.transform_id].curr_mtx;
    const float over = lod_self_error_px(pc.geometry, c, model, transform_max_scale(model), pc.camera.position.xyz, pc.px_per_unit) / LOD_THRESHOLD_PX;
    if (over <= 1.0) return STREAM_FULL_COLOR;
    return mix(STREAM_WAITING_COLOR, STREAM_STARVED_COLOR, clamp(log2(over) / 4.0, 0.0, 1.0));
}

uint material_id(uvec2 v, uvec2 ref) {
    const Instance inst = pc.instances.data[ref.x];
    const uint tri_index = pc.geometry.clusters.data[ref.y].index_base / 3u + v.y;
    const uint slot = geometry_tri_slot(pc.geometry, tri_index, pc.geometry.local_triangles.data[tri_index]);
    if (slot >= pc.geometry.meshes.data[inst.mesh_id].slot_count) return MATERIAL_DEFAULT;
    return slot_material(geometry_slot_entry(pc.geometry, inst.slot_base, slot));
}

bool sample_uv(ivec2 coord, ivec2 size, uvec2 v, uvec2 ref, out vec2 r_uv) {
    const Instance inst = pc.instances.data[ref.x];
    const Mesh mesh = pc.geometry.meshes.data[inst.mesh_id];
    if (mesh.uv_extent.x <= 0.0 && mesh.uv_extent.y <= 0.0) return false;

    const uvec3 cv = triangle_cluster_vertices(ref.y, v.y);
    const uvec4 q0 = pc.geometry.cluster_vertices.data[cv.x];
    const uvec4 q1 = pc.geometry.cluster_vertices.data[cv.y];
    const uvec4 q2 = pc.geometry.cluster_vertices.data[cv.z];

    const mat4 model = pc.transforms.data[inst.transform_id].curr_mtx;
    const vec3 cam = pc.camera.position.xyz;
    const vec3 p0 = (model * vec4(vertex_local(inst, mesh, ref.y, cv.x), 1.0)).xyz - cam;
    const vec3 p1 = (model * vec4(vertex_local(inst, mesh, ref.y, cv.y), 1.0)).xyz - cam;
    const vec3 p2 = (model * vec4(vertex_local(inst, mesh, ref.y, cv.z), 1.0)).xyz - cam;

    const vec2 ndc = (vec2(coord) + 0.5) / vec2(size) * 2.0 - 1.0;
    const vec4 h = pc.camera.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec3 b;
    if (!ray_barycentrics(h.xyz / h.w - cam, p0, p1, p2, b)) return false;

    const vec2 uv = vertex_uv_unorm(q0.zw) * b.x + vertex_uv_unorm(q1.zw) * b.y + vertex_uv_unorm(q2.zw) * b.z;
    r_uv = mesh.uv_min + uv * mesh.uv_extent;
    return true;
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    ivec2 size  = ivec2(pc.width, pc.height);
    if (px.x >= uint(size.x) || px.y >= uint(size.y)) return;
    ivec2 coord = ivec2(px);

    vec3 color = vec3(0.6, 0.0, 0.6);

    if (pc.op == OP_COPY) {
        color = texelFetch(u_textures[nonuniformEXT(pc.src_index)], coord, 0).rgb;
    } else if (pc.op == OP_WIREFRAME) {
        uvec2 v, ref;
        color = vec3(0);
        if (sample_vis(coord, v, ref)) {
            vec3 base = clay_shade(clay_normal(coord, size), view_pos_at(coord, size)) * WIRE_BASE_DIM;
            float d = wire_distance(coord, size, v, ref);
            float line = 1.0 - smoothstep(WIRE_HALF_WIDTH - 0.5, WIRE_HALF_WIDTH + 0.5, d);
            color = mix(base, WIRE_COLOR, line);
        }
    } else if (pc.op == OP_CLAY) {
        color = vec3(0.24);
        float d = texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r;
        if (d != 0.0) color = clay_shade(clay_normal(coord, size), view_pos_at(coord, size));
    } else if (pc.op == OP_TRIANGLES) {
        uvec2 v, ref;
        color = vec3(0);
        if (sample_vis(coord, v, ref)) color = hash_color(hash2(ref.y, v.y));
    } else if (pc.op == OP_CLUSTERS) {
        uvec2 v, ref;
        color = vec3(0);
        if (sample_vis(coord, v, ref)) color = hash_color(hash2(pc.instances.data[ref.x].mesh_id, ref.y));
    } else if (pc.op == OP_INSTANCES) {
        uvec2 v, ref;
        color = vec3(0);
        if (sample_vis(coord, v, ref)) color = hash_color(ref.x + 1u);
    } else if (pc.op == OP_MATERIAL_ID) {
        uvec2 v, ref;
        color = vec3(0);
        if (sample_vis(coord, v, ref)) color = hash_color(material_id(v, ref) + 1u);
    } else if (pc.op == OP_LOD_LEVEL) {
        uvec2 v, ref;
        color = vec3(0);
        if (sample_vis(coord, v, ref)) {
            uint level = min(lod_cluster_level(pc.geometry, ref.y), LOD_HEAT_MAX_LEVEL);
            vec3 base = DEBUG_LEAF_COLOR;
            if (level > 0u) {
                float t = float(level - 1u) / float(max(LOD_HEAT_MAX_LEVEL - 1u, 1u));
                base = color_map_viridis(1.0 - t);
            }
            color = base;
        }
    } else if (pc.op == OP_CLUSTER_ERROR) {
        uvec2 v, ref;
        color = vec3(0);
        if (sample_vis(coord, v, ref)) {
            Cluster c = pc.geometry.clusters.data[ref.y];
            vec3 base = DEBUG_LEAF_COLOR;
            if (c.self_group != CLUSTER_GROUP_NONE) {
                mat4 model = pc.transforms.data[pc.instances.data[ref.x].transform_id].curr_mtx;
                float t = lod_self_error_px(pc.geometry, c, model, transform_max_scale(model), pc.camera.position.xyz, pc.px_per_unit) / LOD_THRESHOLD_PX;
                base = t > 1.0 ? DEBUG_ERROR_COLOR : color_map_viridis(1.0 - t);
            }
            color = base;
        }
    } else if (pc.op == OP_STREAMING) {
        uvec2 v, ref;
        color = vec3(0);
        if (sample_vis(coord, v, ref)) color = streaming_color(ref);
    } else if (pc.op == OP_TRIANGLE_DENSITY) {
        uvec2 v, ref;
        color = vec3(0);
        if (sample_vis(coord, v, ref)) {
            float area = max(triangle_pixel_area(size, v, ref), 1e-6);
            float t = clamp((log2(area) - TRI_DENSITY_LOG2_MIN) / (TRI_DENSITY_LOG2_MAX - TRI_DENSITY_LOG2_MIN), 0.0, 1.0);
            color = color_map_heat(1.0 - t);
        }
    } else if (pc.op == OP_UV_CHECKER) {
        uvec2 v, ref;
        color = vec3(0);
        if (sample_vis(coord, v, ref)) {
            vec2 uv;
            if (sample_uv(coord, size, v, ref, uv)) {
                const vec2 cell = floor(uv * UV_CHECKER_TILES);
                const float check = mod(cell.x + cell.y, 2.0) == 0.0 ? 1.0 : 0.35;
                color = srgb_to_linear(vec3(fract(uv), 0.25)) * check;
            } else {
                color = DEBUG_ERROR_COLOR;
            }
                    }
    } else if (pc.op == OP_OVERDRAW) {
        float n = floor(imageLoad(u_storage_rgba16f[nonuniformEXT(pc.out_slot)], coord).r + 0.5);
        float t = 0.0;
        if (n > 2.0) t = 0.28 + (1.0 - 0.28) * (1.0 - exp2(-(n - 2.0) * 0.25));
        else if (n > 0.0) t = mix(0.12, 0.28, (n - 1.0) / max(2.0 - 1.0, 1.0));
        color = n > 0.0 ? color_map_heat(t) : vec3(0.0);
    } else if (pc.op == OP_DEPTH_NORMAL) {
        vec3 n = view_normal_from_depth(coord, size);
        n.y = -n.y;
        color = n * 0.5 + 0.5;
    } else if (pc.op == OP_WORLD_NORMAL) {
        color = vec3(0);
        float d = texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r;
        if (d != 0.0) {
            vec3 n = gbuffer_decode_normal(texelFetch(u_textures[nonuniformEXT(pc.src_index)], coord, 0).rg);
            color = srgb_to_linear(n * 0.5 + 0.5);
        }
    } else if (pc.op == OP_VELOCITY) {
        vec2 m = texelFetch(u_textures[nonuniformEXT(pc.src_index)], coord, 0).rg;
        const float SCALE = 40.0;
        float speed = length(m) * SCALE;
        float hue = atan(m.y, m.x) / 6.2831853 + 0.5;
        color = hsv_to_rgb(vec3(hue, 1.0, clamp(speed, 0.0, 1.0)));
    } else if (pc.op == OP_DEPTH) {
        color = vec3(linearize_depth(coord));
    }

    imageStore(u_storage_rgba16f[nonuniformEXT(pc.out_slot)], coord, vec4(color, 1.0));
}