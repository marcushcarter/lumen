#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

#include "common/geometry.glsl"
#include "common/camera.glsl"
#include "common/instances.glsl"
#include "common/gbuffer.glsl"
#include "common/lod.glsl"
#include "common/visbuffer.glsl"
#include "common/skinning.glsl"
#include "common/terrain.glsl"
#include "editor/debug_palette.glsl"
#include "editor/debug_op.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform utexture2D u_textures_uint[];
layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1, rgba16f) uniform image2D u_storage_rgba16f[];

layout(buffer_reference, scalar) readonly buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };

layout(push_constant) uniform Push {
    CameraBuffer camera;
    ClusterRefsBuffer cluster_refs;
    InstanceBuffer instances;
    GeometryBuffer geometry;
    TransformBuffer transforms;
    TerrainBuffer terrain;
    uint vis_index;
    uint depth_index;
    uint src_index;
    uint out_slot;
    uint op;
    uint width;
    uint height;
    float px_per_unit;
} pc;

bool sample_vis(ivec2 coord, out uvec2 v, out uvec2 ref) {
    float d = texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r;
    if (d == 0.0) return false;
    const uint raw = texelFetch(u_textures_uint[nonuniformEXT(pc.vis_index)], coord, 0).x;
    if (vis_is_empty(raw) || vis_is_terrain(raw)) return false;
    ref = pc.cluster_refs.data[vis_cluster_ref(raw)];
    v = uvec2(raw, vis_triangle(raw));
    return true;
}

bool sample_raw(ivec2 coord, out uint raw) {
    raw = VIS_EMPTY;
    if (texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r == 0.0) return false;
    raw = texelFetch(u_textures_uint[nonuniformEXT(pc.vis_index)], coord, 0).x;
    return !vis_is_empty(raw);
}

bool terrain_valid() {
    return any(notEqual(uvec2(pc.terrain), uvec2(0u)));
}

vec3 pixel_world(ivec2 coord, ivec2 size) {
    const float d = texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r;
    const vec2 ndc = (vec2(coord) + 0.5) / vec2(size) * 2.0 - 1.0;
    const vec4 h = pc.camera.inv_view_proj * vec4(ndc, d, 1.0);
    return h.xyz / h.w;
}

vec2 terrain_sample_coord(TerrainPatch tp, ivec2 coord, ivec2 size) {
    return (pixel_world(coord, size).xz - pc.terrain.origin_spacing.xz) / pc.terrain.origin_spacing.w;
}

float patch_shade(TerrainPatch tp) {
    return 0.75 + 0.25 * float(hash2(tp.origin_x, tp.origin_z) & 255u) / 255.0;
}

const vec3 OTHER_GEOMETRY = vec3(0.04);
const vec3 STREAM_STATIC = vec3(0.22);
const vec3 STREAM_OK = vec3(0.25, 0.8, 0.3);
const vec3 STREAM_WAIT = vec3(1.0, 0.85, 0.15);
const vec3 STREAM_STARVED = vec3(0.95, 0.12, 0.1);
const float STREAM_STARVED_OCTAVES = 4.0;

const vec3 LEVEL_COLORS[5] = vec3[5](
    vec3(0.95, 0.2, 0.15),
    vec3(1.0, 0.6, 0.1),
    vec3(0.95, 0.9, 0.2),
    vec3(0.3, 0.8, 0.35),
    vec3(0.25, 0.5, 1.0)
);

const vec3 TERRAIN_RESIDENT_COLORS[4] = vec3[4](
    vec3(0.25, 0.8, 0.3),
    vec3(0.7, 0.88, 0.2),
    vec3(1.0, 0.85, 0.15),
    vec3(1.0, 0.55, 0.1)
);

vec3 level_color(uint level) {
    return srgb_to_linear(LEVEL_COLORS[min(level, 4u)]);
}

vec3 checker(vec2 uv) {
    const vec2 cell = floor(uv * 8.0);
    const float check = mod(cell.x + cell.y, 2.0) == 0.0 ? 1.0 : 0.35;
    return srgb_to_linear(vec3(fract(uv), 0.25)) * check;
}

uvec3 triangle_locals(uint cluster, uint tri) {
    const uint lt = pc.geometry.local_triangles.data[pc.geometry.clusters.data[cluster].index_base / 3u + tri];
    return uvec3(lt & 0xFFu, (lt >> 8u) & 0xFFu, (lt >> 16u) & 0xFFu);
}

vec3 vertex_local(Instance inst, Mesh mesh, ClusterStreams streams, uint local) {
    vec3 p = stream_position(pc.geometry, streams, local, mesh.pos_min, mesh.pos_extent);
    if (inst.skin_id != SKIN_NONE) p = skin_point(skin_vertex_rows(pc.camera, pc.geometry, streams, local, pc.camera.skins.data[inst.skin_id].joint_base, SKIN_CURR), p);
    return p;
}

bool sample_uv(ivec2 coord, ivec2 size, uvec2 v, uvec2 ref, out vec2 r_uv) {
    const Instance inst = pc.instances.data[ref.x];
    const Mesh mesh = pc.geometry.meshes.data[inst.mesh_id];
    if (mesh.uv_extent.x <= 0.0 && mesh.uv_extent.y <= 0.0) return false;

    const uvec3 lv = triangle_locals(ref.y, v.y);
    const ClusterStreams streams = cluster_streams(pc.geometry, ref.y);

    const mat4 model = pc.transforms.data[inst.transform_id].curr_mtx;
    const vec3 cam = pc.camera.position.xyz;
    const vec3 p0 = (model * vec4(vertex_local(inst, mesh, streams, lv.x), 1.0)).xyz - cam;
    const vec3 p1 = (model * vec4(vertex_local(inst, mesh, streams, lv.y), 1.0)).xyz - cam;
    const vec3 p2 = (model * vec4(vertex_local(inst, mesh, streams, lv.z), 1.0)).xyz - cam;

    const vec2 ndc = (vec2(coord) + 0.5) / vec2(size) * 2.0 - 1.0;
    const vec4 h = pc.camera.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec3 b;
    if (!ray_barycentrics(h.xyz / h.w - cam, p0, p1, p2, b)) return false;

    r_uv = stream_uv(pc.geometry, streams, lv.x, mesh.uv_min, mesh.uv_extent) * b.x + stream_uv(pc.geometry, streams, lv.y, mesh.uv_min, mesh.uv_extent) * b.y + stream_uv(pc.geometry, streams, lv.z, mesh.uv_min, mesh.uv_extent) * b.z;
    return true;
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    ivec2 size  = ivec2(pc.width, pc.height);
    if (px.x >= uint(size.x) || px.y >= uint(size.y)) return;
    ivec2 coord = ivec2(px);

    vec3 color = vec3(0.6, 0.0, 0.6);

    if (pc.op == OP_COPY) {
        color = texelFetch(u_textures[nonuniformEXT(pc.src_index)], coord, 0).rgb;
    } else if (pc.op == OP_CLUSTERS) {
        uvec2 v, ref;
        color = texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r != 0.0 ? OTHER_GEOMETRY : vec3(0);
        if (sample_vis(coord, v, ref)) color = hash_color(hash2(pc.instances.data[ref.x].mesh_id, ref.y));
    } else if (pc.op == OP_UV_CHECKER) {
        uint raw;
        color = vec3(0);
        if (sample_raw(coord, raw)) {
            if (vis_is_terrain(raw)) {
                if (terrain_valid()) color = checker(terrain_sample_coord(pc.terrain.patches.data[vis_terrain_patch(raw)], coord, size) / float(TERRAIN_TILE_QUADS));
            } else {
                const uvec2 ref = pc.cluster_refs.data[vis_cluster_ref(raw)];
                vec2 uv;
                color = sample_uv(coord, size, uvec2(raw, vis_triangle(raw)), ref, uv) ? checker(uv) : DEBUG_ERROR_COLOR;
            }
        }
    } else if (pc.op == OP_TRIANGLES) {
        uint raw;
        color = vec3(0);
        if (sample_raw(coord, raw)) {
            if (vis_is_terrain(raw)) {
                if (terrain_valid()) {
                    const TerrainPatch tp = pc.terrain.patches.data[vis_terrain_patch(raw)];
                    color = hash_color(hash2(hash2(tp.origin_x, tp.origin_z), (tp.packed & 0xFFu) * 256u + vis_triangle(raw)));
                }
            } else {
                const uvec2 ref = pc.cluster_refs.data[vis_cluster_ref(raw)];
                color = hash_color(hash2(ref.y, vis_triangle(raw)));
            }
        }
    } else if (pc.op == OP_CLUSTER_STREAMING) {
        uint raw;
        color = vec3(0);
        if (sample_raw(coord, raw)) {
            color = OTHER_GEOMETRY;
            if (!vis_is_terrain(raw)) {
                const uvec2 ref = pc.cluster_refs.data[vis_cluster_ref(raw)];
                const Instance inst = pc.instances.data[ref.x];
                const Mesh mesh = pc.geometry.meshes.data[inst.mesh_id];
                const Cluster c = pc.geometry.clusters.data[ref.y];
                const float shade = 0.8 + 0.2 * float(hash2(inst.mesh_id, ref.y) & 255u) / 255.0;
                if ((mesh.flags & MESH_FLAG_STREAMED) == 0u) {
                    color = srgb_to_linear(STREAM_STATIC) * shade;
                } else {
                    const mat4 model = pc.transforms.data[inst.transform_id].curr_mtx;
                    const float err = (inst.flags & INSTANCE_FLAG_PLAYER) != 0u ? 2.0 * LOD_THRESHOLD_PX : lod_self_error_px(pc.geometry, c, model, transform_max_scale(model), pc.camera.position.xyz, pc.px_per_unit);
                    const bool starved = err > LOD_THRESHOLD_PX && !lod_group_refined(pc.geometry, c.self_group);
                    const float t = clamp(log2(err / LOD_THRESHOLD_PX) / STREAM_STARVED_OCTAVES, 0.0, 1.0);
                    color = srgb_to_linear(starved ? mix(STREAM_WAIT, STREAM_STARVED, t) : STREAM_OK) * shade;
                }
            }
        }
    } else if (pc.op == OP_TERRAIN_STREAMING || pc.op == OP_TERRAIN_LOD) {
        uint raw;
        color = vec3(0);
        if (sample_raw(coord, raw)) {
            color = OTHER_GEOMETRY;
            if (vis_is_terrain(raw) && terrain_valid()) {
                const TerrainPatch tp = pc.terrain.patches.data[vis_terrain_patch(raw)];
                if (pc.op == OP_TERRAIN_LOD) {
                    color = level_color(tp.packed & 15u) * patch_shade(tp);
                } else {
                    TerrainBuffer t = pc.terrain;
                    const uint lod = t.tile_table.data[tp.tile].lod;
                    const uvec2 tile = uvec2(tp.tile % t.tiles_x, tp.tile / t.tiles_x);
                    const float shade = ((tile.x + tile.y) & 1u) == 0u ? 1.0 : 0.78;
                    color = srgb_to_linear(lod == TERRAIN_LOD_NONE ? STREAM_STARVED : TERRAIN_RESIDENT_COLORS[min(lod, 3u)]) * shade;
                }
            }
        }
    } else if (pc.op == OP_OVERDRAW) {
        float n = floor(imageLoad(u_storage_rgba16f[nonuniformEXT(pc.out_slot)], coord).r + 0.5);
        float t = 0.0;
        if (n > 2.0) t = 0.28 + (1.0 - 0.28) * (1.0 - exp2(-(n - 2.0) * 0.25));
        else if (n > 0.0) t = mix(0.12, 0.28, (n - 1.0) / max(2.0 - 1.0, 1.0));
        color = n > 0.0 ? color_map_heat(t) : vec3(0.0);
    } else if (pc.op == OP_BASE_COLOR) {
        color = vec3(0);
        if (texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r != 0.0) color = srgb_to_linear(texelFetch(u_textures[nonuniformEXT(pc.src_index)], coord, 0).rgb);
    } else if (pc.op == OP_DEPTH) {
        color = vec3(0);
        if (texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r != 0.0) color = vec3(exp(-distance(pixel_world(coord, size), pc.camera.position.xyz) / 70.0));
    } else if (pc.op == OP_DEPTH_NORMAL) {
        color = vec3(0);
        if (texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r != 0.0) {
            const ivec2 hi = size - 1;
            const vec3 p = pixel_world(coord, size);
            const vec3 xa = pixel_world(min(coord + ivec2(1, 0), hi), size) - p;
            const vec3 xb = p - pixel_world(max(coord - ivec2(1, 0), ivec2(0)), size);
            const vec3 ya = pixel_world(min(coord + ivec2(0, 1), hi), size) - p;
            const vec3 yb = p - pixel_world(max(coord - ivec2(0, 1), ivec2(0)), size);
            const vec3 dx = dot(xa, xa) < dot(xb, xb) ? xa : xb;
            const vec3 dy = dot(ya, ya) < dot(yb, yb) ? ya : yb;
            vec3 n = normalize(cross(dy, dx));
            if (dot(n, pc.camera.position.xyz - p) < 0.0) n = -n;
            color = srgb_to_linear(n * 0.5 + 0.5);
        }
    } else if (pc.op == OP_WATER_CONTEXT) {
        color = texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r != 0.0 ? OTHER_GEOMETRY : vec3(0);
    } else if (pc.op == OP_WORLD_NORMAL) {
        color = vec3(0);
        float d = texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r;
        if (d != 0.0) {
            vec3 n = gbuffer_decode_normal(texelFetch(u_textures[nonuniformEXT(pc.src_index)], coord, 0).rg);
            color = srgb_to_linear(n * 0.5 + 0.5);
        }
    }

    imageStore(u_storage_rgba16f[nonuniformEXT(pc.out_slot)], coord, vec4(color, 1.0));
}