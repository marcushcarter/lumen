#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1, rgba16f) uniform image2D u_storage_rgba16f[];

layout(buffer_reference, scalar) readonly buffer GridParams {
    vec4 clip_z;
    vec4 clip_w;
    vec4 camera;
    vec4 ray;
    vec4 ray_dx;
    vec4 ray_dy;
    vec4 grid_color;
    vec4 axis_x_color;
    vec4 axis_z_color;
    uvec4 size;
};

layout(push_constant, scalar) uniform Push {
    GridParams params;
    uint depth_index;
    uint out_slot;
    uint flags;
} pc;

const uint FLAG_GRID = 1u;
const uint FLAG_AXES = 2u;

const float GRID_MINOR_ALPHA = 0.5;
const float GRID_MAJOR_ALPHA = 1.0;
const float GRID_MAJOR_CELLS = 10.0;
const float GRID_LINE_PX = 1.0;
const float AXIS_LINE_PX = 1.5;
const float DEPTH_TOLERANCE = 1e-3;
const float MIN_ALPHA = 1.0 / 255.0;

vec3 to_srgb(vec3 p_c) {
    return mix(p_c * 12.92, 1.055 * pow(max(p_c, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), p_c));
}

vec3 to_linear(vec3 p_c) {
    return mix(p_c / 12.92, pow((max(p_c, vec3(0.0)) + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), p_c));
}

float grid_lines(vec2 p_uv, vec2 p_deriv) {
    const vec2 target = min(p_deriv * GRID_LINE_PX, vec2(0.5));
    const vec2 draw = clamp(target, p_deriv, vec2(0.5));
    const vec2 aa = max(p_deriv, vec2(1e-6)) * 1.5;
    const vec2 uv = 1.0 - abs(fract(p_uv) * 2.0 - 1.0);
    vec2 g = smoothstep(draw + aa, draw - aa, uv);
    g *= clamp(target / draw, 0.0, 1.0);
    g = mix(g, target, clamp(p_deriv * 2.0 - 1.0, 0.0, 1.0));
    return mix(g.x, 1.0, g.y);
}

float axis_line(float p_coord, float p_deriv) {
    const float px = abs(p_coord) / max(p_deriv, 1e-6);
    return clamp(AXIS_LINE_PX * 0.5 + 0.5 - px, 0.0, 1.0);
}

vec4 grid(GridParams p, vec2 p_center, bool p_grid, bool p_axes, out float r_depth) {
    const vec3 cam = p.camera.xyz;
    const vec3 d = p.ray.xyz + p.ray_dx.xyz * p_center.x + p.ray_dy.xyz * p_center.y;
    r_depth = 0.0;
    if (d.y * cam.y >= 0.0) return vec4(0.0);

    const float t = -cam.y / d.y;
    const vec3 hit = cam + d * t;
    const float dist = distance(hit.xz, cam.xz);
    const float radius = p.camera.w;
    if (dist >= radius) return vec4(0.0);

    const vec3 dx = d + p.ray_dx.xyz;
    const vec3 dy = d + p.ray_dy.xyz;
    const vec2 hit_x = cam.xz + dx.xz * (-cam.y / dx.y);
    const vec2 hit_y = cam.xz + dy.xz * (-cam.y / dy.y);
    const vec2 ddx = hit_x - hit.xz;
    const vec2 ddy = hit_y - hit.xz;
    const vec2 deriv = vec2(length(vec2(ddx.x, ddy.x)), length(vec2(ddx.y, ddy.y)));
    const float fade = 1.0 - smoothstep(radius * 0.5, radius, dist);
    r_depth = dot(p.clip_z, vec4(hit, 1.0)) / dot(p.clip_w, vec4(hit, 1.0));

    vec4 c = vec4(p.grid_color.rgb, 0.0);
    if (p_grid) {
        const float minor = grid_lines(hit.xz, deriv);
        const float major = grid_lines(hit.xz / GRID_MAJOR_CELLS, deriv / GRID_MAJOR_CELLS);
        c.a = max(minor * GRID_MINOR_ALPHA, major * GRID_MAJOR_ALPHA) * p.grid_color.a;
    }
    if (p_axes) {
        const float ax = axis_line(hit.z, deriv.y) * p.axis_x_color.a;
        const float az = axis_line(hit.x, deriv.x) * p.axis_z_color.a;
        if (ax > MIN_ALPHA) c = vec4(mix(c.rgb, p.axis_x_color.rgb, ax / max(max(ax, c.a), 1e-6)), max(c.a, ax));
        if (az > MIN_ALPHA) c = vec4(mix(c.rgb, p.axis_z_color.rgb, az / max(max(az, c.a), 1e-6)), max(c.a, az));
    }
    c.a *= fade;
    return c;
}

void main() {
    GridParams p = pc.params;
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(p.size.x) || pixel.y >= int(p.size.y)) return;
    const vec2 center = vec2(pixel) + 0.5;

    const bool draw_grid = (pc.flags & FLAG_GRID) != 0u;
    const bool draw_axes = (pc.flags & FLAG_AXES) != 0u;
    if (!draw_grid && !draw_axes) return;

    float depth = 0.0;
    const vec4 g = grid(p, center, draw_grid, draw_axes, depth);
    if (g.a < MIN_ALPHA) return;

    const ivec2 sp = ivec2(center * vec2(p.size.zw) / vec2(p.size.xy));
    const float scene = texelFetch(u_textures[pc.depth_index], sp, 0).r * (1.0 - DEPTH_TOLERANCE);
    if (depth < scene) return;

    vec4 c = imageLoad(u_storage_rgba16f[pc.out_slot], pixel);
    c.rgb = to_linear(mix(to_srgb(c.rgb), to_srgb(g.rgb), g.a));
    imageStore(u_storage_rgba16f[pc.out_slot], pixel, c);
}
