#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

#include "common/instances.glsl"
#include "common/visbuffer.glsl"
#include "editor/outline_common.glsl"

const int TILE = 8;
const int MAX_RADIUS = 8;
const int MAX_SIDE = TILE + 2 * MAX_RADIUS;

layout(local_size_x = TILE, local_size_y = TILE) in;

layout(set = 0, binding = 0) uniform utexture2D u_textures_uint[];
layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1, rgba16f) uniform image2D u_storage_rgba16f[];

layout(buffer_reference, scalar) readonly buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };

layout(push_constant, scalar) uniform Push {
    ClusterRefsBuffer cluster_refs;
    InstanceBuffer instances;
    SelectionWordsBuffer mask;
    vec4 color;
    uint vis_index;
    uint depth_index;
    uint out_slot;
    int radius;
    uvec4 rect;
    uvec2 size;
    uvec2 vis_size;
} pc;

shared uint s_ids[MAX_SIDE * MAX_SIDE];
shared uint s_any;

uint selected_id(ivec2 p_pixel) {
    const ivec2 sp = ivec2((vec2(p_pixel) + 0.5) * vec2(pc.vis_size) / vec2(pc.size));
    if (texelFetch(u_textures[nonuniformEXT(pc.depth_index)], sp, 0).r == 0.0) return 0u;
    const uint v = texelFetch(u_textures_uint[nonuniformEXT(pc.vis_index)], sp, 0).r;
    if (vis_is_empty(v) || vis_is_terrain(v)) return 0u;
    const uint entity = pc.instances.data[pc.cluster_refs.data[vis_cluster_ref(v)].x].entity_id;
    return selection_contains(pc.mask, entity) ? entity + 1u : 0u;
}

void main() {
    const int r = pc.radius;
    const int side = TILE + 2 * r;
    const ivec2 rect_min = ivec2(pc.rect.xy);
    const ivec2 rect_max = ivec2(pc.rect.zw);
    const ivec2 origin = rect_min + ivec2(gl_WorkGroupID.xy) * TILE - r;

    if (gl_LocalInvocationIndex == 0u) s_any = 0u;
    barrier();

    uint any_id = 0u;
    for (int i = int(gl_LocalInvocationIndex); i < side * side; i += TILE * TILE) {
        const ivec2 q = origin + ivec2(i % side, i / side);
        const uint id = all(greaterThanEqual(q, rect_min)) && all(lessThan(q, rect_max)) ? selected_id(q) : 0u;
        s_ids[i] = id;
        any_id |= id;
    }
    if (any_id != 0u) atomicOr(s_any, 1u);
    barrier();
    if (s_any == 0u) return;

    const ivec2 p = rect_min + ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= rect_max.x || p.y >= rect_max.y) return;

    const ivec2 l = ivec2(gl_LocalInvocationID.xy) + r;
    const uint self_id = s_ids[l.y * side + l.x];
    int best = 0x7FFFFFFF;
    for (int y = -r; y <= r; y++) {
        for (int x = -r; x <= r; x++) {
            const uint n = s_ids[(l.y + y) * side + l.x + x];
            const int d = x * x + y * y;
            if (n > self_id && d < best) best = d;
        }
    }
    if (best == 0x7FFFFFFF) return;

    const float a = clamp(float(r) + 0.5 - sqrt(float(best)), 0.0, 1.0) * pc.color.a;
    const vec4 c = imageLoad(u_storage_rgba16f[pc.out_slot], p);
    imageStore(u_storage_rgba16f[pc.out_slot], p, vec4(mix(c.rgb, pc.color.rgb, a), c.a));
}
