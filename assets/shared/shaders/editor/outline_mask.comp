#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

#include "common/instances.glsl"
#include "common/visbuffer.glsl"
#include "editor/outline_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform utexture2D u_textures_uint[];
layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1, r32ui) uniform writeonly uimage2D u_storage_r32ui[];

layout(buffer_reference, scalar) readonly buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };
layout(buffer_reference, scalar) readonly buffer SelectionWordsBuffer { uint words[]; };

layout(push_constant) uniform Push {
    ClusterRefsBuffer cluster_refs;
    InstanceBuffer instances;
    SelectionWordsBuffer mask;
    OutlineArgsBuffer args;
    uint word_count;
    uint vis_index;
    uint depth_index;
    uint out_slot;
} pc;

const uint NO_ENTITY = OUTLINE_NO_ENTITY;
const uint HOVER_BIT = OUTLINE_HOVER_BIT;

uint entity_at(ivec2 p) {
    if (texelFetch(u_textures[pc.depth_index], p, 0).r == 0.0) return NO_ENTITY;
    uint v = texelFetch(u_textures_uint[pc.vis_index], p, 0).x;
    if (vis_is_empty(v) || vis_is_terrain(v)) return NO_ENTITY;
    return pc.instances.data[pc.cluster_refs.data[vis_cluster_ref(v)].x].entity_id;
}

bool is_selected(uint p_entity) {
    uint w = p_entity >> 5u;
    return w < pc.word_count && ((pc.mask.words[w] >> (p_entity & 31u)) & 1u) != 0u;
}

void main() {
    const uvec4 rect = pc.args.rect;
    ivec2 p = ivec2(rect.xy) + ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(rect.z) || p.y >= int(rect.w)) return;

    const uint hovered = pc.args.hovered;

    uint id = 0u;
    const uint entity = entity_at(p);
    if (entity != NO_ENTITY) {
        if (is_selected(entity)) id = entity + 1u;
        else if (entity == hovered) id = (entity + 1u) | HOVER_BIT;
    }
    imageStore(u_storage_r32ui[pc.out_slot], p, uvec4(id));
}