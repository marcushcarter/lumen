#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D u_storage_rgba8[];

layout(push_constant) uniform Push {
    uint src_index;
    uint out_slot;
    uint width;
    uint height;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;
    imageStore(u_storage_rgba8[pc.out_slot], p, vec4(texelFetch(u_textures[pc.src_index], p, 0).rgb, 1.0));
}