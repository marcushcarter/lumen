#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

#include "common/camera.glsl"
#include "common/direct_light.glsl"
#include "common/gbuffer.glsl"
#include "common/shading_tiles.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_storage_rgba16f[];

layout(push_constant, scalar) uniform Push {
    CameraBuffer camera;
    ShadingTileBuffer tiles;
    DirectLightBuffer direct_light;
    uint depth_index;
    uint normal_index;
    uint out_slot;
    uint width;
    uint height;
} pc;

const float PI = 3.14159265359;
const float HDR_MAX = 60000.0;
const vec3 ALBEDO = vec3(1.0);

const float SKY_NITS = 8000.0;
const vec3 SKY_ZENITH = vec3(0.32, 0.48, 0.78);
const vec3 SKY_HORIZON = vec3(0.68, 0.73, 0.80);
const vec3 SKY_GROUND = vec3(0.36, 0.37, 0.39);

layout(constant_id = 0) const uint TILE_TYPE = SHADING_TILE_MIXED;

vec3 sky_radiance(vec3 p_dir) {
    const float y = p_dir.y;
    const vec3 c = y >= 0.0 ? mix(SKY_HORIZON, SKY_ZENITH, pow(y, 0.6)) : mix(SKY_HORIZON, SKY_GROUND, pow(min(-y * 4.0, 1.0), 0.5));
    return c * SKY_NITS;
}

vec3 sky_ambient(vec3 p_n) {
    const vec3 up = mix(SKY_HORIZON, SKY_ZENITH, 0.6);
    return mix(SKY_GROUND, up, p_n.y * 0.5 + 0.5) * SKY_NITS;
}

void main() {
    const uint group = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (group >= pc.tiles.args[TILE_TYPE].w) return;
    const uvec2 tile = shading_tile_unpack(pc.tiles.tiles[TILE_TYPE * pc.tiles.capacity + group]);
    ivec2 p = ivec2(tile * SHADING_TILE_SIZE + gl_LocalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;

    float depth = TILE_TYPE == SHADING_TILE_SKY ? 0.0 : texelFetch(u_textures[pc.depth_index], p, 0).r;
    if (depth == 0.0) {
        const vec2 ndc = (vec2(p) + 0.5) * (2.0 / vec2(pc.width, pc.height)) - 1.0;
        const vec4 h = pc.camera.inv_view_proj * vec4(ndc, 1.0, 1.0);
        const vec3 dir = normalize(h.xyz / h.w - pc.camera.position.xyz);
        imageStore(u_storage_rgba16f[pc.out_slot], p, vec4(min(sky_radiance(dir) * pc.camera.pre_exposure, vec3(HDR_MAX)), 1.0));
        return;
    }

    vec3 n = gbuffer_decode_normal(texelFetch(u_textures[pc.normal_index], p, 0).rg);

    vec3 direct = ALBEDO / PI * pc.direct_light.illuminance * clamp(dot(n, -pc.direct_light.direction), 0.0, 1.0);
    vec3 ambient = ALBEDO * sky_ambient(n);

    vec3 color = (direct + ambient) * pc.camera.pre_exposure;
    imageStore(u_storage_rgba16f[pc.out_slot], p, vec4(min(color, vec3(HDR_MAX)), 1.0));
}
