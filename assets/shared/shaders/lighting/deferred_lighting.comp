#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

#include "common/camera.glsl"
#include "common/direct_light.glsl"
#include "common/gbuffer.glsl"
#include "common/shading_tiles.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_storage_rgba16f[];
layout(set = 0, binding = 2) uniform samplerShadow u_shadow_samplers[];

layout(push_constant, scalar) uniform Push {
    CameraBuffer camera;
    ShadingTileBuffer tiles;
    DirectLightBuffer direct_light;
    uint depth_index;
    uint normal_index;
    uint out_slot;
    uint width;
    uint height;
    uint player_shadow_index;
    uint shadow_sampler_index;
} pc;

const uint SHADOW_MAP_NONE = 0xFFFFFFFFu;

const float PI = 3.14159265359;
const float HDR_MAX = 60000.0;
const vec3 ALBEDO = vec3(1.0);

const float SKY_NITS = 8000.0;
const vec3 SKY_ZENITH = vec3(0.32, 0.48, 0.78);
const vec3 SKY_HORIZON = vec3(0.68, 0.73, 0.80);
const vec3 SKY_GROUND = vec3(0.36, 0.37, 0.39);

layout(constant_id = 0) const uint TILE_TYPE = SHADING_TILE_MIXED;

vec3 sky_radiance(vec3 p_dir) {
    const float y = p_dir.y;
    const vec3 c = y >= 0.0 ? mix(SKY_HORIZON, SKY_ZENITH, pow(y, 0.6)) : mix(SKY_HORIZON, SKY_GROUND, pow(min(-y * 4.0, 1.0), 0.5));
    return c * SKY_NITS;
}

vec3 sky_ambient(vec3 p_n) {
    const vec3 up = mix(SKY_HORIZON, SKY_ZENITH, 0.6);
    return mix(SKY_GROUND, up, p_n.y * 0.5 + 0.5) * SKY_NITS;
}

bool player_shadow_covers(ivec2 p_pixel) {
    const uvec4 r = pc.direct_light.player_shadow_rect;
    return pc.player_shadow_index != SHADOW_MAP_NONE && uint(p_pixel.x) >= r.x && uint(p_pixel.y) >= r.y && uint(p_pixel.x) < r.z && uint(p_pixel.y) < r.w;
}

float player_shadow(vec2 p_ndc, float p_depth, vec3 p_n) {
    const vec4 params = pc.direct_light.player_shadow_params;
    const vec4 h = pc.direct_light.player_shadow_screen * vec4(p_ndc, p_depth, 1.0);
    const vec3 s = h.xyz / h.w + mat3(pc.direct_light.player_shadow_view_proj) * (p_n * params.x);
    const vec2 uv = s.xy * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))) || s.z <= 0.0 || s.z >= 1.0) return 1.0;
    const float ref = s.z - params.y;
    const vec2 texel = 0.5 / vec2(textureSize(u_textures[nonuniformEXT(pc.player_shadow_index)], 0));
    float lit = 0.0;
    lit += texture(sampler2DShadow(u_textures[nonuniformEXT(pc.player_shadow_index)], u_shadow_samplers[nonuniformEXT(pc.shadow_sampler_index)]), vec3(uv + vec2(-texel.x, -texel.y), ref));
    lit += texture(sampler2DShadow(u_textures[nonuniformEXT(pc.player_shadow_index)], u_shadow_samplers[nonuniformEXT(pc.shadow_sampler_index)]), vec3(uv + vec2(texel.x, -texel.y), ref));
    lit += texture(sampler2DShadow(u_textures[nonuniformEXT(pc.player_shadow_index)], u_shadow_samplers[nonuniformEXT(pc.shadow_sampler_index)]), vec3(uv + vec2(-texel.x, texel.y), ref));
    lit += texture(sampler2DShadow(u_textures[nonuniformEXT(pc.player_shadow_index)], u_shadow_samplers[nonuniformEXT(pc.shadow_sampler_index)]), vec3(uv + vec2(texel.x, texel.y), ref));
    return lit * 0.25;
}

void main() {
    const uint group = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (group >= pc.tiles.args[TILE_TYPE].w) return;
    const uvec2 tile = shading_tile_unpack(pc.tiles.tiles[TILE_TYPE * pc.tiles.capacity + group]);
    ivec2 p = ivec2(tile * SHADING_TILE_SIZE + gl_LocalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;

    float depth = TILE_TYPE == SHADING_TILE_SKY ? 0.0 : texelFetch(u_textures[pc.depth_index], p, 0).r;
    if (depth == 0.0) {
        const vec2 ndc = (vec2(p) + 0.5) * (2.0 / vec2(pc.width, pc.height)) - 1.0;
        const vec4 h = pc.camera.inv_view_proj * vec4(ndc, 1.0, 1.0);
        const vec3 dir = normalize(h.xyz / h.w - pc.camera.position.xyz);
        imageStore(u_storage_rgba16f[pc.out_slot], p, vec4(min(sky_radiance(dir) * pc.camera.pre_exposure, vec3(HDR_MAX)), 1.0));
        return;
    }

    vec3 n = gbuffer_decode_normal(texelFetch(u_textures[pc.normal_index], p, 0).rg);

    const float n_dot_l = clamp(dot(n, -pc.direct_light.direction), 0.0, 1.0);
    float shadow = 1.0;
    if (n_dot_l > 0.0 && player_shadow_covers(p)) shadow = player_shadow((vec2(p) + 0.5) * (2.0 / vec2(pc.width, pc.height)) - 1.0, depth, n);
    vec3 direct = ALBEDO / PI * pc.direct_light.illuminance * n_dot_l * shadow;
    vec3 ambient = ALBEDO * sky_ambient(n);

    vec3 color = (direct + ambient) * pc.camera.pre_exposure;
    imageStore(u_storage_rgba16f[pc.out_slot], p, vec4(min(color, vec3(HDR_MAX)), 1.0));
}
