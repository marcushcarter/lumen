#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require

#include "lighting/player_shadow_common.glsl"

layout(local_size_x = 1) in;

layout(push_constant, scalar) uniform Push {
    PlayerShadowListBuffer list;
    uint triangle_capacity;
    uint cluster_capacity;
} pc;

const uint PLAYER_SHADOW_SKIN_GROUP = 64u;
const uint PLAYER_SHADOW_DISPATCH_MAX = 65535u;

void main() {
    const uint culled = pc.list.culled_total;
    const uint masked = pc.list.masked_total;
    pc.list.draws[PLAYER_SHADOW_DRAW_CULLED] = PlayerShadowDraw(culled * 3u, 1u, 0u, 0, 0u);
    pc.list.draws[PLAYER_SHADOW_DRAW_MASKED] = PlayerShadowDraw(masked * 3u, 1u, (pc.triangle_capacity - masked) * 3u, 0, 0u);
    const uint groups = (min(pc.list.cluster_count, pc.cluster_capacity) + PLAYER_SHADOW_SKIN_GROUP - 1u) / PLAYER_SHADOW_SKIN_GROUP;
    pc.list.skin_dispatch = uvec3(min(groups, PLAYER_SHADOW_DISPATCH_MAX), (groups + PLAYER_SHADOW_DISPATCH_MAX - 1u) / PLAYER_SHADOW_DISPATCH_MAX, 1u);
}
