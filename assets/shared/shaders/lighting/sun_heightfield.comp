#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require

#include "common/terrain.glsl"

const uint THREADS = 1024u;
const uint LINE = 2u * THREADS;
const uint NO_INDEX = 0xFFFFFFFFu;
const float NO_VALUE = -3.402823e38;

layout(local_size_x = 1024) in;

layout(set = 0, binding = 1, r32ui) uniform writeonly uimage2D u_storage_r32ui[];

layout(push_constant, scalar) uniform Push {
    TerrainBuffer terrain;
    vec2 center;
    vec2 sun;
    float texel;
    float drop;
    float height_min;
    float inv_range;
    uint size;
    uint prefix;
    uint column_base;
    uint skip;
    uint out_slot;
    uint coarse;
} pc;

shared float s_value[THREADS];
shared uint s_index[THREADS];
shared float s_even[THREADS];

float height_at(TerrainBuffer t, vec2 p_xz) {
    const vec2 s = (p_xz - t.origin_spacing.xz) / t.origin_spacing.w;
    const vec2 limit = vec2(t.samples_x - 1u, t.samples_y - 1u);
    if (any(lessThan(s, vec2(0.0))) || any(greaterThan(s, limit))) return pc.height_min;
    if (pc.coarse != 0u) return max(pc.height_min, terrain_level_height(t, terrain_tile_at(t, s), TERRAIN_COARSE_LEVEL, s));
    float unused;
    return max(pc.height_min, terrain_height(t, s, unused));
}

void take(inout float r_value, inout uint r_index, float p_value, uint p_index) {
    if (p_index != NO_INDEX && (p_value > r_value || (p_value == r_value && p_index > r_index))) {
        r_value = p_value;
        r_index = p_index;
    }
}

void prefix_through(int p_last, out float r_value, out uint r_index) {
    r_value = NO_VALUE;
    r_index = NO_INDEX;
    if (p_last < 0) return;
    const uint q = uint(p_last);
    const uint u = q >> 1u;
    if ((q & 1u) != 0u) {
        r_value = s_value[u];
        r_index = s_index[u];
        return;
    }
    if (u > 0u) {
        r_value = s_value[u - 1u];
        r_index = s_index[u - 1u];
    }
    take(r_value, r_index, s_even[u], q);
}

void store(uint p_column, uint p_element) {
    if (p_element < pc.prefix) return;
    const uint row = p_element - pc.prefix;
    if (row >= pc.size) return;
    float best;
    uint best_index;
    prefix_through(int(p_element) - 1 - int(pc.skip), best, best_index);
    const float shadow_height = best - float(p_element) * pc.drop;
    const uint hn = best_index == NO_INDEX ? 0u : uint(clamp((shadow_height - pc.height_min) * pc.inv_range, 0.0, 1.0) * 65535.0 + 0.5);
    const uint dn = best_index == NO_INDEX ? 0u : min(p_element - best_index, 65535u);
    imageStore(u_storage_r32ui[nonuniformEXT(pc.out_slot)], ivec2(p_column, row), uvec4(hn | (dn << 16u), 0u, 0u, 0u));
}

void main() {
    const uint column = gl_WorkGroupID.x + pc.column_base;
    if (column >= pc.size) return;
    const uint t = gl_LocalInvocationID.x;
    TerrainBuffer terrain = pc.terrain;

    const vec2 side = vec2(-pc.sun.y, pc.sun.x);
    const float half_extent = 0.5 * float(pc.size) * pc.texel;
    const vec2 line_origin = pc.center + side * ((float(column) + 0.5) * pc.texel - half_extent) + pc.sun * (half_extent + float(pc.prefix) * pc.texel);

    const uint e0 = 2u * t;
    const uint e1 = e0 + 1u;
    const float a0 = height_at(terrain, line_origin - pc.sun * ((float(e0) + 0.5) * pc.texel)) + float(e0) * pc.drop;
    const float a1 = height_at(terrain, line_origin - pc.sun * ((float(e1) + 0.5) * pc.texel)) + float(e1) * pc.drop;

    float value = a0;
    uint index = e0;
    take(value, index, a1, e1);
    s_value[t] = value;
    s_index[t] = index;
    s_even[t] = a0;
    barrier();

    for (uint offset = 1u; offset < THREADS; offset <<= 1u) {
        float other = NO_VALUE;
        uint other_index = NO_INDEX;
        if (t >= offset) {
            other = s_value[t - offset];
            other_index = s_index[t - offset];
        }
        barrier();
        take(value, index, other, other_index);
        s_value[t] = value;
        s_index[t] = index;
        barrier();
    }

    store(column, e0);
    store(column, e1);
}
