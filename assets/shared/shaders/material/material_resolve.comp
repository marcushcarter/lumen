#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

#include "common/geometry.glsl"
#include "common/camera.glsl"
#include "common/instances.glsl"
#include "common/gbuffer.glsl"
#include "common/visbuffer.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform utexture2D u_textures_uint[];
layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 2) uniform sampler u_samplers[];

layout(set = 0, binding = 1, rgba8) uniform writeonly image2D u_storage_rgba8[];
layout(set = 0, binding = 1, rgb10_a2) uniform writeonly image2D u_storage_rgb10a2[];
layout(set = 0, binding = 1, rg16) uniform writeonly image2D u_storage_rg16[];
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D u_storage_rg16f[];
layout(set = 0, binding = 1, r11f_g11f_b10f) uniform writeonly image2D u_storage_r11g11b10f[];

layout(buffer_reference, scalar) readonly buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };

layout(push_constant) uniform Push {
    CameraBuffer camera;
    GeometryBuffer geometry;
    InstanceBuffer instances;
    TransformBuffer transforms;
    ClusterRefsBuffer cluster_refs;
    uint vis_index;
    uint normal_slot;
    uint albedo_slot;
    uint material_slot;
    uint custom_slot;
    uint motion_slot;
    uint emissive_slot;
    uint width;
    uint height;
    uint flags;
    uint sampler_index;
} pc;

const uint RESOLVE_WRITE_MOTION = 1u << 0;
const uint RESOLVE_WRITE_CUSTOM = 1u << 1;
const float EMISSIVE_MAX = 60000.0;
const vec3 UNSUPPORTED_MODEL_COLOR = vec3(1.0, 0.0, 1.0);

struct Surface {
    vec3 normal;
    vec2 motion;
    vec3 albedo;
    float roughness;
    float metallic;
    float ao;
    vec3 emissive;
    uint shading_model;
};

void surface_default(out Surface r_s) {
    r_s.normal = vec3(0.0, 1.0, 0.0);
    r_s.motion = vec2(0.0);
    r_s.albedo = vec3(1.0);
    r_s.roughness = 0.5;
    r_s.metallic = 0.0;
    r_s.ao = 1.0;
    r_s.emissive = vec3(0.0);
    r_s.shading_model = SHADING_MODEL_DEFAULT_LIT;
}

vec3 to_world_rel(mat4 p_model, vec3 p_cam, vec3 p_local) {
    return p_model[0].xyz * p_local.x + p_model[1].xyz * p_local.y + p_model[2].xyz * p_local.z + (p_model[3].xyz - p_cam);
}

bool ray_barycentrics(vec3 p_dir, vec3 p_0, vec3 p_1, vec3 p_2, out vec3 r_bary) {
    vec3 e1 = p_1 - p_0;
    vec3 e2 = p_2 - p_0;
    vec3 pv = cross(p_dir, e2);
    float det = dot(e1, pv);
    if (abs(det) < 1e-20) return false;
    float inv_det = 1.0 / det;
    vec3 tv = -p_0;
    float u = dot(tv, pv) * inv_det;
    vec3 qv = cross(tv, e1);
    float v = dot(p_dir, qv) * inv_det;
    r_bary = vec3(1.0 - u - v, u, v);
    return true;
}

vec4 sample_material(uint p_tex, vec2 p_uv, vec2 p_dx, vec2 p_dy) {
    return textureGrad(sampler2D(u_textures[nonuniformEXT(p_tex)], u_samplers[pc.sampler_index]), p_uv, p_dx, p_dy);
}

bool triangle_tangent(mat4 p_model, vec3 p_l0, vec3 p_l1, vec3 p_l2, vec2 p_uv0, vec2 p_uv1, vec2 p_uv2, vec3 p_n, out vec3 r_t, out vec3 r_b) {
    vec3 e1 = p_l1 - p_l0;
    vec3 e2 = p_l2 - p_l0;
    vec2 d1 = p_uv1 - p_uv0;
    vec2 d2 = p_uv2 - p_uv0;
    float det = d1.x * d2.y - d1.y * d2.x;
    if (abs(det) < 1e-12) return false;
    float r = 1.0 / det;
    vec3 t = mat3(p_model) * ((e1 * d2.y - e2 * d1.y) * r);
    vec3 b = mat3(p_model) * ((e2 * d1.x - e1 * d2.x) * r);
    t -= p_n * dot(p_n, t);
    float len = length(t);
    if (len < 1e-8) return false;
    r_t = t / len;
    r_b = cross(p_n, r_t) * (dot(cross(p_n, r_t), b) < 0.0 ? -1.0 : 1.0);
    return true;
}

bool resolve_surface(uint p_vis, vec2 p_ndc, vec3 p_dir, vec3 p_dir_dx, vec3 p_dir_dy, bool p_motion, out Surface r_s) {
    surface_default(r_s);
    if (vis_is_terrain(p_vis)) return false;

    const uvec2 ref = pc.cluster_refs.data[vis_cluster_ref(p_vis)];
    const Instance inst = pc.instances.data[ref.x];
    const uint i0 = pc.geometry.clusters.data[ref.y].index_base + vis_triangle(p_vis) * 3u;

    const uint v0 = pc.geometry.indices.data[i0 + 0u];
    const uint v1 = pc.geometry.indices.data[i0 + 1u];
    const uint v2 = pc.geometry.indices.data[i0 + 2u];

    const Mesh mesh = pc.geometry.meshes.data[inst.mesh_id];
    const vec3 l0 = mesh.pos_min + vertex_position_unorm(pc.geometry.vertices.data[v0]) * mesh.pos_extent;
    const vec3 l1 = mesh.pos_min + vertex_position_unorm(pc.geometry.vertices.data[v1]) * mesh.pos_extent;
    const vec3 l2 = mesh.pos_min + vertex_position_unorm(pc.geometry.vertices.data[v2]) * mesh.pos_extent;

    const mat4 model = pc.transforms.data[inst.transform_id].curr_mtx;
    const vec3 cam = pc.camera.position.xyz;
    const vec3 p0 = to_world_rel(model, cam, l0);
    const vec3 p1 = to_world_rel(model, cam, l1);
    const vec3 p2 = to_world_rel(model, cam, l2);

    vec3 b;
    if (!ray_barycentrics(p_dir, p0, p1, p2, b)) return false;
    vec3 b_dx, b_dy;
    if (!ray_barycentrics(p_dir_dx, p0, p1, p2, b_dx)) b_dx = b;
    if (!ray_barycentrics(p_dir_dy, p0, p1, p2, b_dy)) b_dy = b;

    const uvec2 a0 = pc.geometry.attributes.data[v0];
    const uvec2 a1 = pc.geometry.attributes.data[v1];
    const uvec2 a2 = pc.geometry.attributes.data[v2];
    const vec3 local_n = oct_decode(vertex_normal_oct(a0)) * b.x + oct_decode(vertex_normal_oct(a1)) * b.y + oct_decode(vertex_normal_oct(a2)) * b.z;
    const mat3 cof = mat3(cross(model[1].xyz, model[2].xyz), cross(model[2].xyz, model[0].xyz), cross(model[0].xyz, model[1].xyz));
    const vec3 n = normalize(cof * local_n);
    r_s.normal = n;

    if (p_motion) {
        const vec3 local = l0 * b.x + l1 * b.y + l2 * b.z;
        const vec4 prev_world = pc.transforms.data[inst.transform_id].prev_mtx * vec4(local, 1.0);
        const vec4 prev_clip = pc.camera.prev_view_proj * prev_world;
        if (prev_clip.w > 0.0) r_s.motion = (p_ndc - prev_clip.xy / prev_clip.w) * 0.5;
    }

    const uint slot = pc.geometry.tri_slots.data[i0 / 3u];
    const uint material_index = (inst.slot_base == 0u || slot >= mesh.slot_count) ? MATERIAL_DEFAULT : pc.geometry.slot_table.data[inst.slot_base + slot];
    const Material m = pc.geometry.materials.data[material_index];

    r_s.shading_model = material_shading_model(m);
    if (r_s.shading_model != SHADING_MODEL_DEFAULT_LIT) {
        r_s.albedo = vec3(0.0);
        r_s.roughness = 1.0;
        r_s.metallic = 0.0;
        r_s.emissive = UNSUPPORTED_MODEL_COLOR / max(pc.camera.pre_exposure, 1e-8);
        return true;
    }

    const vec2 uv0 = mesh.uv_min + vertex_uv_unorm(a0) * mesh.uv_extent;
    const vec2 uv1 = mesh.uv_min + vertex_uv_unorm(a1) * mesh.uv_extent;
    const vec2 uv2 = mesh.uv_min + vertex_uv_unorm(a2) * mesh.uv_extent;
    const vec2 raw_uv = uv0 * b.x + uv1 * b.y + uv2 * b.z;
    const vec2 uv = raw_uv * m.uv_transform.xy + m.uv_transform.zw;
    const vec2 uv_dx = (uv0 * b_dx.x + uv1 * b_dx.y + uv2 * b_dx.z - raw_uv) * m.uv_transform.xy;
    const vec2 uv_dy = (uv0 * b_dy.x + uv1 * b_dy.y + uv2 * b_dy.z - raw_uv) * m.uv_transform.xy;

    r_s.albedo = m.base_color.rgb;
    if (m.base_color_tex != TEXTURE_NONE) r_s.albedo *= sample_material(m.base_color_tex, uv, uv_dx, uv_dy).rgb;

    r_s.roughness = m.roughness;
    if (m.roughness_tex != TEXTURE_NONE) r_s.roughness *= sample_material(m.roughness_tex, uv, uv_dx, uv_dy).r;
    r_s.metallic = m.metallic;
    if (m.metallic_tex != TEXTURE_NONE) r_s.metallic *= sample_material(m.metallic_tex, uv, uv_dx, uv_dy).r;
    r_s.ao = 1.0;
    if (m.ao_tex != TEXTURE_NONE) r_s.ao = 1.0 + m.ao_strength * (sample_material(m.ao_tex, uv, uv_dx, uv_dy).r - 1.0);

    r_s.emissive = m.emissive;
    if (m.emissive_tex != TEXTURE_NONE) r_s.emissive *= sample_material(m.emissive_tex, uv, uv_dx, uv_dy).rgb;

    vec3 t, bt;
    if (m.normal_tex != TEXTURE_NONE && triangle_tangent(model, l0, l1, l2, uv0, uv1, uv2, n, t, bt)) {
        vec2 xy = (sample_material(m.normal_tex, uv, uv_dx, uv_dy).rg * 2.0 - 1.0) * m.normal_scale;
        float z = sqrt(clamp(1.0 - dot(xy, xy), 0.0, 1.0));
        r_s.normal = normalize(t * xy.x + bt * xy.y + n * z);
    }

    r_s.roughness = clamp(r_s.roughness, 0.0, 1.0);
    r_s.metallic = clamp(r_s.metallic, 0.0, 1.0);
    r_s.ao = clamp(r_s.ao, 0.0, 1.0);
    return true;
}

const uint SWIZZLE_STRIP = 8u;

uvec2 swizzled_group(uint p_groups_x, uint p_groups_y) {
    const uint gid = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    const uint per_strip = SWIZZLE_STRIP * p_groups_y;
    const uint strip = gid / per_strip;
    const uint in_strip = gid - strip * per_strip;
    const uint w = min(SWIZZLE_STRIP, p_groups_x - strip * SWIZZLE_STRIP);
    return uvec2(strip * SWIZZLE_STRIP + in_strip % w, in_strip / w);
}

vec3 pixel_dir(vec2 p_ndc) {
    const vec4 near_h = pc.camera.inv_view_proj * vec4(p_ndc, 1.0, 1.0);
    return near_h.xyz / near_h.w - pc.camera.position.xyz;
}

void main() {
    const uint groups_x = (pc.width + 7u) / 8u;
    const uint groups_y = (pc.height + 7u) / 8u;
    if (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x >= groups_x * groups_y) return;
    const uvec2 px = swizzled_group(groups_x, groups_y) * 8u + gl_LocalInvocationID.xy;
    if (px.x >= pc.width || px.y >= pc.height) return;
    const ivec2 coord = ivec2(px);

    const uint v = texelFetch(u_textures_uint[pc.vis_index], coord, 0).x;

    if (vis_is_empty(v)) {
        imageStore(u_storage_rgba8[pc.material_slot], coord, gbuffer_encode_material(0.0, 0.0, 0.0, SHADING_MODEL_SKY));
        if ((pc.flags & RESOLVE_WRITE_CUSTOM) != 0u) imageStore(u_storage_rgba8[pc.custom_slot], coord, vec4(0.0));
        if ((pc.flags & RESOLVE_WRITE_MOTION) != 0u) imageStore(u_storage_rg16f[pc.motion_slot], coord, vec4(0.0));
        imageStore(u_storage_r11g11b10f[pc.emissive_slot], coord, vec4(0.0));
        return;
    }

    const vec2 texel = 2.0 / vec2(pc.width, pc.height);
    const vec2 ndc = (vec2(coord) + 0.5) * texel - 1.0;
    const vec3 dir = pixel_dir(ndc);
    const vec3 dir_dx = pixel_dir(ndc + vec2(texel.x, 0.0));
    const vec3 dir_dy = pixel_dir(ndc + vec2(0.0, texel.y));

    Surface s;
    const bool write_motion = (pc.flags & RESOLVE_WRITE_MOTION) != 0u;
    resolve_surface(v, ndc, dir, dir_dx, dir_dy, write_motion, s);

    imageStore(u_storage_rgb10a2[pc.albedo_slot], coord, gbuffer_encode_albedo(s.albedo, 0u));
    imageStore(u_storage_rg16[pc.normal_slot], coord, vec4(gbuffer_encode_normal(s.normal), 0.0, 0.0));
    imageStore(u_storage_rgba8[pc.material_slot], coord, gbuffer_encode_material(s.roughness, s.metallic, s.ao, s.shading_model));
    if ((pc.flags & RESOLVE_WRITE_CUSTOM) != 0u) imageStore(u_storage_rgba8[pc.custom_slot], coord, vec4(0.0));
    imageStore(u_storage_r11g11b10f[pc.emissive_slot], coord, vec4(min(s.emissive, vec3(EMISSIVE_MAX)), 0.0));
    if (write_motion) imageStore(u_storage_rg16f[pc.motion_slot], coord, vec4(s.motion, 0.0, 0.0));
}