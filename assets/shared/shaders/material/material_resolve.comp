#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

#include "common/geometry.glsl"
#include "common/camera.glsl"
#include "common/instances.glsl"
#include "common/gbuffer.glsl"
#include "common/visbuffer.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform utexture2D u_textures_uint[];
layout(set = 0, binding = 0) uniform texture2D u_textures[];

layout(set = 0, binding = 1, rgba8) uniform image2D u_storage_rgba8[];
layout(set = 0, binding = 1, rgb10_a2) uniform image2D u_storage_rgb10a2[];
layout(set = 0, binding = 1, rg16)  uniform image2D u_storage_rg16[];
layout(set = 0, binding = 1, rg16f) uniform image2D u_storage_rg16f[];

layout(buffer_reference, scalar) readonly buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };

layout(push_constant) uniform Push {
    CameraBuffer camera;
    GeometryBuffer geometry;
    InstanceBuffer instances;
    TransformBuffer transforms;
    ClusterRefsBuffer cluster_refs;
    uint vis_index;
    uint depth_index;
    uint normal_slot;
    uint albedo_slot;
    uint material_slot;
    uint custom_slot;
    uint motion_slot;
    uint width;
    uint height;
} pc;

bool clip_barycentrics(vec4 p_c0, vec4 p_c1, vec4 p_c2, vec2 p_ndc, out vec3 r_bary) {
    mat3 m = mat3(p_c0.xyw, p_c1.xyw, p_c2.xyw);
    float det = determinant(m);
    if (abs(det) < 1e-20) return false;
    vec3 l = inverse(m) * vec3(p_ndc, 1.0);
    float s = l.x + l.y + l.z;
    if (abs(s) < 1e-20) return false;
    r_bary = l / s;
    return true;
}

vec3 decode_vertex_normal(i16vec2 p_n) {
    vec2 f = max(vec2(p_n) / 32767.0, vec2(-1.0));
    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.xy += vec2(n.x >= 0.0 ? -t : t, n.y >= 0.0 ? -t : t);
    return normalize(n);
}

bool resolve_surface(uvec2 p_vis, ivec2 p_coord, out vec3 r_normal, out vec2 r_motion) {
    r_normal = vec3(0.0, 1.0, 0.0);
    r_motion = vec2(0.0);
    if (vis_is_terrain(p_vis)) return false;

    uvec2 ref = pc.cluster_refs.data[vis_cluster_ref(p_vis)];
    Instance inst = pc.instances.data[ref.x];
    Mesh mesh = pc.geometry.meshes.data[inst.mesh_id];
    Cluster cluster = pc.geometry.clusters.data[ref.y];
    Transform xf = pc.transforms.data[inst.transform_id];

    uint i0 = cluster.index_base + vis_triangle(p_vis) * 3u;
    Vertex v0 = pc.geometry.vertices.data[pc.geometry.indices.data[i0 + 0u]];
    Vertex v1 = pc.geometry.vertices.data[pc.geometry.indices.data[i0 + 1u]];
    Vertex v2 = pc.geometry.vertices.data[pc.geometry.indices.data[i0 + 2u]];
    vec3 l0 = mesh.pos_min + (vec3(v0.position) / 65535.0) * mesh.pos_extent;
    vec3 l1 = mesh.pos_min + (vec3(v1.position) / 65535.0) * mesh.pos_extent;
    vec3 l2 = mesh.pos_min + (vec3(v2.position) / 65535.0) * mesh.pos_extent;

    mat4 curr_mvp = pc.camera.curr_view_proj * xf.curr_mtx;
    vec2 ndc = (vec2(p_coord) + 0.5) / vec2(pc.width, pc.height) * 2.0 - 1.0;

    vec3 b;
    if (!clip_barycentrics(curr_mvp * vec4(l0, 1.0), curr_mvp * vec4(l1, 1.0), curr_mvp * vec4(l2, 1.0), ndc, b)) return false;

    mat3 m = mat3(xf.curr_mtx);
    mat3 cof = mat3(cross(m[1], m[2]), cross(m[2], m[0]), cross(m[0], m[1]));
    vec3 local_n = decode_vertex_normal(v0.normal) * b.x + decode_vertex_normal(v1.normal) * b.y + decode_vertex_normal(v2.normal) * b.z;
    r_normal = normalize(cof * local_n);

    vec3 local = l0 * b.x + l1 * b.y + l2 * b.z;
    vec4 curr_clip = curr_mvp * vec4(local, 1.0);
    vec4 prev_clip = pc.camera.prev_view_proj * xf.prev_mtx * vec4(local, 1.0);
    if (curr_clip.w > 0.0 && prev_clip.w > 0.0) r_motion = (curr_clip.xy / curr_clip.w - prev_clip.xy / prev_clip.w) * 0.5;
    return true;
}

void main() {
    uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= pc.width || px.y >= pc.height) return;
    ivec2 coord = ivec2(px);

    float depth = texelFetch(u_textures[nonuniformEXT(pc.depth_index)], coord, 0).r;

    if (depth == 0.0) {
        imageStore(u_storage_rgb10a2[nonuniformEXT(pc.albedo_slot)], coord, vec4(0.0));
        imageStore(u_storage_rg16[nonuniformEXT(pc.normal_slot)], coord, vec4(0.0));
        imageStore(u_storage_rgba8[nonuniformEXT(pc.material_slot)], coord, gbuffer_encode_material(0.0, 0.0, 0.0, SHADING_MODEL_SKY));
        imageStore(u_storage_rgba8[nonuniformEXT(pc.custom_slot)], coord, vec4(0.0));
        imageStore(u_storage_rg16f[nonuniformEXT(pc.motion_slot)], coord, vec4(0.0));
        return;
    }

    uvec2 v = texelFetch(u_textures_uint[nonuniformEXT(pc.vis_index)], coord, 0).xy;
    vec3 normal;
    vec2 motion;
    resolve_surface(v, coord, normal, motion);

    imageStore(u_storage_rgb10a2[nonuniformEXT(pc.albedo_slot)], coord, gbuffer_encode_albedo(vec3(0.8), 0u));
    imageStore(u_storage_rg16[nonuniformEXT(pc.normal_slot)], coord, vec4(gbuffer_encode_normal(normal), 0.0, 0.0));
    imageStore(u_storage_rgba8[nonuniformEXT(pc.material_slot)], coord, gbuffer_encode_material(0.5, 0.0, 1.0, SHADING_MODEL_DEFAULT_LIT));
    imageStore(u_storage_rgba8[nonuniformEXT(pc.custom_slot)], coord, vec4(0.0));
    imageStore(u_storage_rg16f[nonuniformEXT(pc.motion_slot)], coord, vec4(motion, 0.0, 0.0));
}