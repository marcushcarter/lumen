#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#include "common/geometry.glsl"
#include "common/camera.glsl"
#include "common/instances.glsl"
#include "common/gbuffer.glsl"
#include "common/visbuffer.glsl"
#include "common/shading_tiles.glsl"
#include "common/skinning.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform utexture2D u_textures_uint[];

layout(set = 0, binding = 1, rg16) uniform writeonly image2D u_storage_rg16[];
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D u_storage_rg16f[];

layout(buffer_reference, scalar) readonly buffer ClusterRefsBuffer { uint count; uint _pad; uvec2 data[]; };

layout(push_constant) uniform Push {
    CameraBuffer camera;
    GeometryBuffer geometry;
    InstanceBuffer instances;
    TransformBuffer transforms;
    ClusterRefsBuffer cluster_refs;
    ShadingTileBuffer shading_tiles;
    SkinCacheBuffer skin_cache;
    uint vis_index;
    uint normal_slot;
    uint motion_slot;
    uint width;
    uint height;
    uint flags;
} pc;

const uint RESOLVE_WRITE_MOTION = 1u << 0;

struct Surface {
    vec3 normal;
    vec2 motion;
};

struct Object {
    vec3 m0;
    vec3 m1;
    vec3 m2;
    vec3 m3;
    vec3 c0;
    vec3 c1;
    vec3 c2;
    vec3 pos_min;
    vec3 pos_extent;
    uint transform_id;
    uint slot_base;
    uint slot_count;
    uint mesh_id;
    uint skin_id;
};

struct Triangle {
    vec3 l0;
    vec3 l1;
    vec3 l2;
    vec3 n0;
    vec3 n1;
    vec3 n2;
    uint slot;
};

Object load_object(uint p_inst) {
    Object o;
    const uint mesh_id = pc.instances.data[p_inst].mesh_id;
    o.transform_id = pc.instances.data[p_inst].transform_id;
    o.slot_base = pc.instances.data[p_inst].slot_base;
    o.mesh_id = mesh_id;
    o.skin_id = pc.instances.data[p_inst].skin_id;
    const mat4 mtx = pc.transforms.data[o.transform_id].curr_mtx;
    o.m0 = mtx[0].xyz;
    o.m1 = mtx[1].xyz;
    o.m2 = mtx[2].xyz;
    o.m3 = mtx[3].xyz;
    o.c0 = cross(o.m1, o.m2);
    o.c1 = cross(o.m2, o.m0);
    o.c2 = cross(o.m0, o.m1);
    o.pos_min = pc.geometry.meshes.data[mesh_id].pos_min;
    o.pos_extent = pc.geometry.meshes.data[mesh_id].pos_extent;
    o.slot_count = pc.geometry.meshes.data[mesh_id].slot_count;
    return o;
}

uvec3 load_triangle_locals(uint p_cluster, uint p_tri, out uint r_slot) {
    const uint tri_index = pc.geometry.clusters.data[p_cluster].index_base / 3u + p_tri;
    const uint lt = pc.geometry.local_triangles.data[tri_index];
    r_slot = lt >> 24u;
    if (r_slot == LOCAL_TRI_SLOT_OVERFLOW) r_slot = pc.geometry.tri_slots.data[tri_index];
    return uvec3(lt & 0xFFu, (lt >> 8u) & 0xFFu, (lt >> 16u) & 0xFFu);
}

vec3 object_to_world_rel(Object p_o, vec3 p_cam, vec3 p_local) {
    return p_o.m0 * p_local.x + p_o.m1 * p_local.y + p_o.m2 * p_local.z + (p_o.m3 - p_cam);
}

vec3 cached_normal(uint p_index) {
    return oct_decode_unnormalized(unpackSnorm2x16(pc.skin_cache.normals.data[p_index]));
}

bool resolve_surface(uint p_vis, vec2 p_ndc, vec3 p_dir, bool p_motion, out Surface r_s) {
    r_s.normal = vec3(0.0, 1.0, 0.0);
    r_s.motion = vec2(0.0);
    if (vis_is_terrain(p_vis)) return false;

    const uint ref_index = vis_cluster_ref(p_vis);
    const uvec2 ref = pc.cluster_refs.data[ref_index];
    const Object o = load_object(ref.x);
    Triangle tri;
    const uvec3 lv = load_triangle_locals(ref.y, vis_triangle(p_vis), tri.slot);
    const ClusterStreams streams = cluster_streams(pc.geometry, ref.y);
    vec3 prev0, prev1, prev2;
    const uint cached = o.skin_id != SKIN_NONE ? skin_cache_base(pc.skin_cache, ref_index) : SKIN_CACHE_NONE;
    if (cached != SKIN_CACHE_NONE) {
        tri.l0 = pc.skin_cache.positions.data[cached + lv.x];
        tri.l1 = pc.skin_cache.positions.data[cached + lv.y];
        tri.l2 = pc.skin_cache.positions.data[cached + lv.z];
        tri.n0 = cached_normal(cached + lv.x);
        tri.n1 = cached_normal(cached + lv.y);
        tri.n2 = cached_normal(cached + lv.z);
        prev0 = tri.l0;
        prev1 = tri.l1;
        prev2 = tri.l2;
        if (p_motion) {
            prev0 = pc.skin_cache.prev_positions.data[cached + lv.x];
            prev1 = pc.skin_cache.prev_positions.data[cached + lv.y];
            prev2 = pc.skin_cache.prev_positions.data[cached + lv.z];
        }
    } else {
        tri.l0 = stream_position(pc.geometry, streams, lv.x, o.pos_min, o.pos_extent);
        tri.l1 = stream_position(pc.geometry, streams, lv.y, o.pos_min, o.pos_extent);
        tri.l2 = stream_position(pc.geometry, streams, lv.z, o.pos_min, o.pos_extent);
        tri.n0 = oct_decode_unnormalized(stream_normal_oct(pc.geometry, streams, lv.x));
        tri.n1 = oct_decode_unnormalized(stream_normal_oct(pc.geometry, streams, lv.y));
        tri.n2 = oct_decode_unnormalized(stream_normal_oct(pc.geometry, streams, lv.z));
        prev0 = tri.l0;
        prev1 = tri.l1;
        prev2 = tri.l2;
        if (o.skin_id != SKIN_NONE) {
            const uint joint_base = pc.camera.skins.data[o.skin_id].joint_base;
            const SkinRows k0 = skin_vertex_rows(pc.camera, pc.geometry, streams, lv.x, joint_base, SKIN_CURR);
            const SkinRows k1 = skin_vertex_rows(pc.camera, pc.geometry, streams, lv.y, joint_base, SKIN_CURR);
            const SkinRows k2 = skin_vertex_rows(pc.camera, pc.geometry, streams, lv.z, joint_base, SKIN_CURR);
            if (p_motion) {
                prev0 = skin_point(skin_vertex_rows(pc.camera, pc.geometry, streams, lv.x, joint_base, SKIN_PREV), tri.l0);
                prev1 = skin_point(skin_vertex_rows(pc.camera, pc.geometry, streams, lv.y, joint_base, SKIN_PREV), tri.l1);
                prev2 = skin_point(skin_vertex_rows(pc.camera, pc.geometry, streams, lv.z, joint_base, SKIN_PREV), tri.l2);
            }
            tri.l0 = skin_point(k0, tri.l0);
            tri.l1 = skin_point(k1, tri.l1);
            tri.l2 = skin_point(k2, tri.l2);
            tri.n0 = skin_direction(k0, tri.n0);
            tri.n1 = skin_direction(k1, tri.n1);
            tri.n2 = skin_direction(k2, tri.n2);
        }
    }

    const vec3 cam = pc.camera.position.xyz;
    const vec3 p0 = object_to_world_rel(o, cam, tri.l0);
    const vec3 p1 = object_to_world_rel(o, cam, tri.l1);
    const vec3 p2 = object_to_world_rel(o, cam, tri.l2);

    vec3 b;
    if (!ray_barycentrics(p_dir, p0, p1, p2, b)) return false;

    const vec3 local_n = tri.n0 * b.x + tri.n1 * b.y + tri.n2 * b.z;
    vec3 n = normalize(o.c0 * local_n.x + o.c1 * local_n.y + o.c2 * local_n.z);

    if (p_motion) {
        const vec3 local = prev0 * b.x + prev1 * b.y + prev2 * b.z;
        const vec4 prev_world = pc.transforms.data[o.transform_id].prev_mtx * vec4(local, 1.0);
        const vec4 prev_clip = pc.camera.prev_view_proj * prev_world;
        if (prev_clip.w > 0.0) r_s.motion = ((p_ndc - pc.camera.jitter.xy) - (prev_clip.xy / prev_clip.w - pc.camera.jitter.zw)) * 0.5;
    }

    const uint material_index = (o.slot_base == 0u || tri.slot >= o.slot_count) ? MATERIAL_DEFAULT : slot_material(pc.geometry.slot_table.data[o.slot_base + tri.slot]);
    const Material m = pc.geometry.materials.data[material_index];
    if (material_two_sided(m)) {
        const vec3 ng = cross(p1 - p0, p2 - p0);
        if (dot(ng, p_dir) * dot(ng, n) > 0.0) n = -n;
    }
    r_s.normal = n;
    return true;
}

const uint SWIZZLE_STRIP = 8u;

uvec2 swizzled_group(uint p_groups_x, uint p_groups_y) {
    const uint gid = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    const uint per_strip = SWIZZLE_STRIP * p_groups_y;
    const uint strip = gid / per_strip;
    const uint in_strip = gid - strip * per_strip;
    const uint w = min(SWIZZLE_STRIP, p_groups_x - strip * SWIZZLE_STRIP);
    return uvec2(strip * SWIZZLE_STRIP + in_strip % w, in_strip / w);
}

shared uint s_paths;

bool resolve_pixel(ivec2 coord) {
    const uint v = texelFetch(u_textures_uint[pc.vis_index], coord, 0).x;

    const vec2 ndc = (vec2(coord) + 0.5) * (2.0 / vec2(pc.width, pc.height)) - 1.0;
    const vec3 cam = pc.camera.position.xyz;
    const vec4 h = pc.camera.inv_view_proj * vec4(ndc, 1.0, 1.0);
    const bool write_motion = (pc.flags & RESOLVE_WRITE_MOTION) != 0u;

    if (vis_is_empty(v)) {
        if (write_motion) {
            const vec4 prev_clip = pc.camera.prev_view_proj * vec4(h.xyz / h.w - cam, 0.0);
            const vec2 motion = prev_clip.w > 0.0 ? ((ndc - pc.camera.jitter.xy) - (prev_clip.xy / prev_clip.w - pc.camera.jitter.zw)) * 0.5 : vec2(0.0);
            imageStore(u_storage_rg16f[pc.motion_slot], coord, vec4(motion, 0.0, 0.0));
        }
        return false;
    }

    Surface s;
    resolve_surface(v, ndc, h.xyz / h.w - cam, write_motion, s);

    imageStore(u_storage_rg16[pc.normal_slot], coord, vec4(gbuffer_encode_normal(s.normal), 0.0, 0.0));
    if (write_motion) imageStore(u_storage_rg16f[pc.motion_slot], coord, vec4(s.motion, 0.0, 0.0));
    return true;
}

void classify_tile(uvec2 p_tile, uint p_tiles) {
    const uint type = shading_tile_type(s_paths);
    const uint k = atomicAdd(pc.shading_tiles.args[type].w, 1u);
    pc.shading_tiles.tiles[type * p_tiles + k] = shading_tile_pack(p_tile);
    memoryBarrierBuffer();
    if (atomicAdd(pc.shading_tiles.done, 1u) != p_tiles - 1u) return;
    pc.shading_tiles.capacity = p_tiles;
    for (uint t = 0u; t < SHADING_TILE_TYPES; t++) {
        const uint count = atomicAdd(pc.shading_tiles.args[t].w, 0u);
        pc.shading_tiles.args[t].x = min(count, SHADING_TILE_DISPATCH_MAX);
        pc.shading_tiles.args[t].y = (count + SHADING_TILE_DISPATCH_MAX - 1u) / SHADING_TILE_DISPATCH_MAX;
        pc.shading_tiles.args[t].z = 1u;
    }
}

void main() {
    const uint groups_x = (pc.width + SHADING_TILE_SIZE - 1u) / SHADING_TILE_SIZE;
    const uint groups_y = (pc.height + SHADING_TILE_SIZE - 1u) / SHADING_TILE_SIZE;
    const uint tiles = groups_x * groups_y;
    if (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x >= tiles) return;
    const uvec2 tile = swizzled_group(groups_x, groups_y);
    const uvec2 px = tile * SHADING_TILE_SIZE + gl_LocalInvocationID.xy;

    if (gl_LocalInvocationIndex == 0u) s_paths = 0u;
    barrier();
    const uint path = (px.x < pc.width && px.y < pc.height) ? (resolve_pixel(ivec2(px)) ? SHADING_PATH_LIT : SHADING_PATH_SKY) : 0u;
    const uint wave_paths = subgroupOr(path);
    if (subgroupElect()) atomicOr(s_paths, wave_paths);
    barrier();
    if (gl_LocalInvocationIndex == 0u) classify_tile(tile, tiles);
}