#version 460
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_scalar_block_layout : require

#include "common/tonemap.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D u_textures[];
layout(set = 0, binding = 2) uniform sampler u_samplers[];
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_storage_rgba16f[];

layout(push_constant, scalar) uniform Push {
    uint src_index;
    uint sampler_index;
    uint out_slot;
    uint width;
    uint height;
    float exposure_scale;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;

    const vec2 uv = (vec2(p) + 0.5) / vec2(pc.width, pc.height);
    const vec3 hdr = max(textureLod(sampler2D(u_textures[pc.src_index], u_samplers[pc.sampler_index]), uv, 0.0).rgb, vec3(0.0)) * pc.exposure_scale;
    imageStore(u_storage_rgba16f[pc.out_slot], p, display_output(hdr, p));
}
