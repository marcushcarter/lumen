#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#include "common/geometry.glsl"

#define WG_SIZE 256u
#define ITEMS 4u
#define TILE (WG_SIZE * ITEMS)
layout(local_size_x = 256) in;

struct DrawIndexedIndirectCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

layout(buffer_reference, scalar) readonly buffer CountBuffer { uint data[]; };
layout(buffer_reference, scalar) writeonly buffer OffsetBuffer { uint data[]; };
layout(buffer_reference, scalar) writeonly buffer DrawCmdBuffer { DrawIndexedIndirectCommand cmds[]; };
layout(buffer_reference, scalar) writeonly buffer DrawCountBuffer { uint value; };
layout(buffer_reference, scalar) writeonly buffer HiZArgsBuffer { uvec3 build; };

layout(push_constant) uniform Push {
    GeometryBuffer geometry;
    CountBuffer counts;
    OffsetBuffer offsets;
    DrawCmdBuffer draw_cmds;
    DrawCountBuffer draw_count;
    HiZArgsBuffer hiz_args;
    uint cluster_count;
    uint hiz_groups_x;
    uint hiz_groups_y;
} pc;

shared uvec2 s_sub[WG_SIZE];
shared uvec2 s_total;

void main() {
    const uint lid = gl_LocalInvocationID.x;
    const uint slot = gl_SubgroupID * gl_SubgroupSize + gl_SubgroupInvocationID;
    uvec2 running = uvec2(0u);

    for (uint t = 0u; t < pc.cluster_count; t += TILE) {
        const uint base = t + slot * ITEMS;
        uint c[ITEMS];
        uvec2 pre[ITEMS];
        uvec2 local = uvec2(0u);
        for (uint k = 0u; k < ITEMS; k++) {
            const uint cid = base + k;
            c[k] = cid < pc.cluster_count ? pc.counts.data[cid] : 0u;
            pre[k] = local;
            local += uvec2(c[k], c[k] > 0u ? 1u : 0u);
        }

        const uvec2 incl = subgroupInclusiveAdd(local);
        if (gl_SubgroupInvocationID == gl_SubgroupSize - 1u) s_sub[gl_SubgroupID] = incl;
        barrier();

        if (gl_SubgroupID == 0u) {
            uvec2 carry = uvec2(0u);
            for (uint i = 0u; i < gl_NumSubgroups; i += gl_SubgroupSize) {
                const uint idx = i + gl_SubgroupInvocationID;
                const uvec2 v = idx < gl_NumSubgroups ? s_sub[idx] : uvec2(0u);
                const uvec2 x = subgroupExclusiveAdd(v) + carry;
                if (idx < gl_NumSubgroups) s_sub[idx] = x;
                carry += subgroupAdd(v);
            }
            if (gl_SubgroupInvocationID == 0u) s_total = carry;
        }
        barrier();

        const uvec2 thread_base = running + s_sub[gl_SubgroupID] + incl - local;
        for (uint k = 0u; k < ITEMS; k++) {
            const uint cid = base + k;
            if (cid >= pc.cluster_count) break;
            const uvec2 ex = thread_base + pre[k];
            pc.offsets.data[cid] = ex.x;
            if (c[k] > 0u) {
                DrawIndexedIndirectCommand cmd;
                cmd.index_count = pc.geometry.clusters.data[cid].index_count;
                cmd.instance_count = c[k];
                cmd.first_index = pc.geometry.clusters.data[cid].index_base;
                cmd.vertex_offset = 0;
                cmd.first_instance = ex.x;
                pc.draw_cmds.cmds[ex.y] = cmd;
            }
        }

        running += s_total;
        barrier();
    }

    if (lid == 0u) {
        pc.draw_count.value = running.y;
        if (pc.hiz_groups_x != 0u) {
            const bool any = running.y > 0u;
            pc.hiz_args.build = any ? uvec3(pc.hiz_groups_x, pc.hiz_groups_y, 1u) : uvec3(0u, 1u, 1u);
        }
    }
}